---
interface Props { name: string; label: string; options: { value: string; label: string }[] }
const { name, label, options } = Astro.props;
---
<fieldset class="filter-choices" data-filter-group={name}>
  <legend>{label}</legend>
  <div class="filter-options">
    {options.map(option => <label><input type="checkbox" name={name} value={option.value} /> {option.label}</label>)}
    <button type="button" data-clear-filter={name}>全部</button>
  </div>
</fieldset>
<style>
  .filter-choices{margin:.75rem 0;padding:.5rem .75rem .75rem;border:1px solid var(--line,#c4bbaa);min-width:0}
  legend{font-weight:bold;padding:0 .3rem}.filter-options{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1rem}
  .filter-options label{display:inline-flex;align-items:center;gap:.35rem;min-height:32px;cursor:pointer}
  .filter-options input{margin:0;accent-color:#692b28;width:1rem;height:1rem}
  .filter-options button{margin-left:auto;padding:.2rem .6rem;min-height:32px;font:inherit}
</style>
