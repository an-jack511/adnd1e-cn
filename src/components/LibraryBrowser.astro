---
import {itemSelectionKind} from '../utils/item-selection';
import FilterChoices from './FilterChoices.astro';
interface Entry {id:string;nameZh:string;nameEn:string;description?:string;category?:string;subCategory?:string;price?:string;speedFactor?:string;damageSmallMedium?:string;damageLarge?:string;primeRequisite?:string;modifiers?:string;abilities?:unknown[];details?:{html:string;title:string}[];source:{book:string}[];catalogHidden?:boolean;aliases?:string[]}
interface Props {entries:Entry[];kind:'equipment'|'magic'|'classes'|'races'}
const {entries:allEntries,kind}=Astro.props;
const entries=allEntries.filter(entry=>!entry.catalogHidden);
const categories=[...new Set(entries.map(entry=>entry.category).filter(Boolean))] as string[];
const types=[...new Set(entries.map(entry=>entry.subCategory).filter(Boolean))].sort() as string[];
const sources=[...new Set(entries.flatMap(entry=>entry.source.map(source=>source.book)))].sort();
const path=(id:string)=>`/${kind==='magic'?'equipment':kind}/${id}/`;
const plain=(s:string)=>s.replace(/<[^>]+>/g,' ').replace(/\s+/g,' ');
---
<div class="library-catalog" data-library-kind={kind}>
 <div class="library-filters controls"><div class="filter-grid"><label>检索 <input id="library-name" type="search" placeholder="中文、英文、能力或正文" /></label>{kind==='equipment' && <><label>价格上限（gp）<input id="library-price" type="number" min="0" /></label><label>速度因子<input id="library-speed" type="search" size="5" /></label><label>伤害<input id="library-damage" type="search" size="7" /></label></>}</div>
 {categories.length>1 && <FilterChoices name="category" label="类别" options={categories.map(value=>({value,label:value}))} />}
 {types.length>0 && <FilterChoices name="type" label="细类" options={types.map(value=>({value,label:value}))} />}
 <FilterChoices name="source" label="来源" options={sources.map(value=>({value,label:value}))} /></div>
 <div class="library-selection" hidden><strong id="library-selected-count">已选 0 件</strong><button type="button" data-library-apply>将所选物品加入人物卡</button><button type="button" data-library-cancel>取消</button></div>
 <p id="library-count" class="results-count" role="status">显示 {entries.length} 项</p>
 <div class="library-browser"><div class="library-list table-wrap" tabindex="0" aria-label="资料列表"><table class="data-table compact"><thead><tr><th class="library-check" hidden>选取</th><th aria-sort="none"><button type="button" data-library-sort="name">条目 ↕</button></th><th aria-sort="none"><button type="button" data-library-sort="type">{kind==='classes'?'主属性':kind==='races'?'属性调整':'类别'}</button></th>{(kind==='equipment'||kind==='magic') && <th aria-sort="none"><button type="button" data-library-sort="price">价格 ↕</button></th>}<th aria-sort="none"><button type="button" data-library-sort="source">来源 ↕</button></th></tr></thead><tbody>{entries.map(entry=><tr data-library-id={entry.id} data-record={JSON.stringify({selectionKind:itemSelectionKind(entry),name:entry.nameZh,type:entry.subCategory??entry.category??entry.primeRequisite??entry.modifiers,source:entry.source[0]?.book,search:[entry.nameZh,entry.nameEn,entry.description,...(entry.aliases??[]),...(entry.details??[]).map(d=>plain(d.title+' '+d.html))].join(' ').toLowerCase(),price:entry.price,speed:entry.speedFactor,damage:`${entry.damageSmallMedium??''} ${entry.damageLarge??''}`,facets:{category:[entry.category],type:[entry.subCategory],source:entry.source.map(s=>s.book)}})}><td class="library-check" hidden><input type="checkbox" value={entry.id} aria-label={`选取${entry.nameZh}`} /></td><td><a href={path(entry.id)} data-library-entry>{entry.nameZh}</a><small class="library-english">{entry.nameEn}</small></td><td>{kind==='classes'?entry.primeRequisite:kind==='races'?entry.modifiers:entry.subCategory??entry.category}</td>{(kind==='equipment'||kind==='magic') && <td>{entry.price}</td>}<td>{[...new Set(entry.source.map(s=>s.book))].join(' · ')}</td></tr>)}</tbody></table><p class="library-no-results" hidden>没有符合筛选条件的条目。</p></div>
 <section class="library-preview" aria-label="条目详情"><div class="library-preview-heading"><strong id="library-current-title">条目详情</strong><a id="library-full-entry" href={entries[0]?path(entries[0].id):'/'} target="_top">单页阅读 ↗</a></div><iframe id="library-detail-frame" title="完整条目规则" src={entries[0]?`${path(entries[0].id)}?view=embedded`:undefined}></iframe></section></div>
</div>
<script>import {initLibraryBrowser} from '../utils/library-browser';initLibraryBrowser();</script>
