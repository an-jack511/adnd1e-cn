---
import SourceList from '../components/SourceList.astro';
import LibraryRules from '../components/LibraryRules.astro';
import { races } from '../data/public/races';
import { classes } from '../data/public/classes';
const { entry } = Astro.props;
---
<article class="library-entry identity-entry"><h1>{entry.nameZh} <small>{entry.nameEn}</small></h1>
<div data-identity-overview><div class="table-wrap"><table class="data-table compact"><tbody>
<tr><th>属性调整</th><td>{entry.modifiers}</td></tr><tr><th>移动</th><td>{entry.movement}</td></tr>
<tr><th>语言</th><td>{entry.languages}</td></tr><tr><th>豁免</th><td>{entry.savingThrows}</td></tr>
<tr><th>侦察</th><td>{entry.detection}</td></tr>
</tbody></table></div>
<h2>可选职业与等级上限</h2><div class="table-wrap"><table class="data-table compact"><thead><tr><th>职业</th><th>等级上限</th></tr></thead><tbody>{entry.eligibleClasses.map(({ id, limit }) => <tr><td><a href={`/classes/${id}/`}>{classes.find((item) => item.id === id)?.nameZh ?? id}</a></td><td>{limit}</td></tr>)}</tbody></table></div>
<h2>多职业</h2><p>{entry.multiclass.join(' · ')}</p>
<h2>种族能力</h2><ul>{entry.abilities.map((ability) => <li>{ability}</li>)}</ul>
</div><LibraryRules prefix={entry.id} details={entry.details} /><SourceList sources={entry.source} details={entry.details} /><p><a href="/races">← 返回种族</a></p></article>
