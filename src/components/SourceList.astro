---
import type { SourceReference,LibraryDetail } from '../schemas';
import { books } from '../data/public/books';
import { sourceSectionLabel } from '../utils/terminology';

interface Props { sources: SourceReference[];details?:LibraryDetail[] }
const { sources:allSources,details=[] } = Astro.props;
const sources=allSources.filter(source=>!details.some(detail=>detail.source.book===source.book&&(!source.page||detail.source.page===source.page)));
const bookHref = (book: string) => books.find((entry) => entry.short === book || entry.title === book)?.id;
---
{sources.length>0 && <div class="source-list">
  <span class="label">来源：</span>
  {sources.map((source, index) => (
    <span class="source-ref">
      {index > 0 && <span aria-hidden="true"> · </span>}
      {bookHref(source.book) ? <a href={`/books/${bookHref(source.book)}`}>{source.book}</a> : source.book}
      {source.page ? ` p.${source.page}` : ''}{source.section ? source.book === 'UA' && source.section.startsWith('ua-') ? <> · <a href={`/books/ua/${source.section}/`}>对应章节</a></> : /^Dragon #\d+$/.test(source.book) && bookHref(source.book) ? <> · <a href={`/books/${bookHref(source.book)}/${source.section}/`}>规则摘要</a></> : ` · ${sourceSectionLabel(source.section)}` : ''}
    </span>
  ))}
</div>}
