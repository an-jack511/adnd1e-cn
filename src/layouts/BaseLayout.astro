---
import '../styles/global.css';
import '../styles/library.css';
import '../../public/wiki.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { title?: string; description?: string; noIndex?: boolean; bodyClass?:string; characterPage?:string; createStage?:string }
const { title = 'AD&D 第一版中文规则索引', description = 'AD&D 1st Edition 中文规则参考站。', noIndex = false, bodyClass='', characterPage, createStage } = Astro.props;
const pageTitle = title === 'AD&D 第一版中文规则索引' ? title : `${title} · AD&D 1E 中文规则索引`;
const segments = Astro.url.pathname.split('/').filter(Boolean);
const isHome = segments.length === 0;
const sectionNames: Record<string, string> = {
  reference: '规则书检索', adventure: '冒险规则', combat: '战斗规则', races: '种族', classes: '职业',
  spells: '法术表', equipment: '装备与物品', monsters: '怪物合集',
  psionics: '灵能与其他规则', character: '人物卡', books: '规则书',
  rules: '规则索引', tables: '随机表', search: '全站搜索', illustrations: '插图', play: '游戏中', dm: '主持游戏'
};
const section = segments[0] === 'read' ? 'books' : segments[0];
const sectionHref = section === 'illustrations' ? '/monsters/' : `/${section}/`;
const sectionTitle = section === 'illustrations' ? '怪物合集' : sectionNames[section];
const crumbTitle = segments.length > 1 ? title.replace(/^.*? · /, '').replace(/\s+[A-Z][A-Za-z -]*$/, '') : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>try{const palette=localStorage.getItem('adnd1e-palette');document.documentElement.dataset.palette=['forest','ochre','scarlet','mono','purple-orange'].includes(palette)?palette:'forest';}catch{document.documentElement.dataset.palette='forest';}</script>
    <script is:inline>try{const p=localStorage.getItem('adnd1e-theme')||'system';document.documentElement.dataset.themePreference=p;document.documentElement.dataset.theme=p==='dark'||p!=='light'&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}</script>
    <script is:inline>if(new URLSearchParams(location.search).get('view')==='embedded')document.documentElement.classList.add('library-embedded');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/theme.css" />
  </head>
  <body class={`${isHome ? 'home-page' : `section-${section}`} ${bodyClass}`} data-character-page={characterPage} data-create-stage={createStage}>
    <SiteHeader />
    <main class="page-shell">
      {!isHome && <nav class="breadcrumbs" aria-label="当前位置"><a href="/">首页</a> &gt; {section === 'books' && segments.length > 2 ? <><a href="/books/">规则书</a> &gt; <a href={segments[0]==='read' ? `/read/${segments[1]}/` : `/books/${segments[1]}/`}>{segments[1].toUpperCase()}</a> &gt; <span>{title.split(' · ')[0]}</span></> : segments.length > 1 ? <><a href={sectionHref}>{sectionTitle}</a> &gt; <span>{crumbTitle}</span></> : <span>{sectionTitle}</span>}</nav>}
      <slot />
    </main>
    <SiteFooter />
    <script is:inline src="/book-toc.js" defer></script>
    <script is:inline src="/theme.js" defer></script>
  </body>
</html>
