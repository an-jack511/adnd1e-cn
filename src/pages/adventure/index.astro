---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { rules } from '../../data/public/rules';
import { playPages } from '../../data/public/play';
const guide = playPages.find((page) => page.slug === 'travel')!;
const entries = rules.filter((rule) => rule.category === 'adventure');
---
<BaseLayout title="冒险规则">
  <h1>冒险规则</h1>
  <p>{guide.intro}</p>
  <h2>旅行与探索次序</h2>
  <ol>{guide.sequence.map((step) => <li>{step}</li>)}</ol>
  <p>速查：{guide.sections.map((section, index) => <span><a href={`/play/travel/#${section.id}`}>{section.title}</a>{index < guide.sections.length - 1 ? ' · ' : ''}</span>)}</p>
  <h2>常用规则</h2>
  <table class="directory-groups"><tbody>{entries.map((rule) => <tr><th scope="row"><a href={`/adventure/${rule.id}/`}>{rule.title}</a></th><td>{rule.summary}</td></tr>)}</tbody></table>
  <p><a href="/play/travel/">阅读完整探索流程与出处</a> · <a href="/play/encounter/">遭遇</a> · <a href="/dm/">主持人工具</a></p>
</BaseLayout>
