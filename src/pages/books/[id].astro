---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import { books } from '../../data/public/books';
export function getStaticPaths() { return books.map((book) => ({ params: { id: book.id }, props: { book } })); }
const { book } = Astro.props;
---
<BaseLayout title={`${book.short} · ${book.titleZh}`}><article><header class="entry-header"><h1>{book.titleZh}</h1><div class="english">{book.short} · {book.title}</div></header><p>{book.description}</p><p class="notice">【内容说明】此处目前仅有章节索引；连续正文将在确认授权后加入。</p><h2>章节目录</h2><ul>{book.chapters.map((chapter) => <li><a href={chapter.href}>{chapter.title}</a></li>)}</ul><SourceList sources={book.source} /><p><a href="/books">← 返回规则书</a></p></article></BaseLayout>
