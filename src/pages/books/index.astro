---
import BaseLayout from '../../layouts/BaseLayout.astro';
import directory from '../../data/public/book-directory.json';
import { books } from '../../data/public/books';
import published from '../../data/published/topics';
const catalog = [...directory,...books.filter(book=>!directory.some(entry=>entry.id===book.id)&&published.some(topic=>topic.book===book.id)).map(book=>({...book,group:'其他资料 Other Resources',archive:''}))];
const groups = [...new Set(catalog.map(book=>book.group))];
---
<BaseLayout title="规则书">
  <div class="section-heading"><h1>规则书</h1><a href="/reference/">检索原书章节与表格</a></div>
  {groups.map(group=><section><h2>{group}</h2><div class="table-wrap"><table class="data-table">
    <thead><tr><th>书名</th><th>英文名</th><th>简称</th><th>阅读</th></tr></thead>
    <tbody>{catalog.filter(book=>book.group===group).map(book=>{
      const hasChapters=published.some(topic=>topic.book===book.id);
      const href=book.archive ? `/read/${book.id}/` : `/books/${book.id}/`;
      return <tr><td><a href={href}>{book.titleZh}</a></td><td>{book.title}</td><td>{book.short}</td><td><a href={href}>阅读</a></td></tr>;
    })}</tbody>
  </table></div></section>)}
</BaseLayout>
