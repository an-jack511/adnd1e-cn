---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bookshelf from '../../components/Bookshelf.astro';
import { libraryBooks, libraryCategories } from '../../data/bookshelf';
---
<BaseLayout title="规则书库">
  <header class="shelf-page-heading">
    <h1>规则书库</h1>
    <p>从书架上挑一本，翻开 AD&amp;D 第一版的世界。</p>
    <nav class="shelf-page-links" aria-label="图书馆导航"><a href="/rules/">规则库</a><a href="/manuals/">自编手册与法术书 →</a><a href="/reference/">检索原书章节与表格</a></nav>
  </header>
  <Bookshelf books={libraryBooks} categories={libraryCategories} label="规则书库" />
</BaseLayout>
