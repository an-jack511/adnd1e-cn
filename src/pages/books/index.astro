---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { books } from '../../data/public/books';
import published from '../../data/published/books.json';
---
<BaseLayout title="规则书"><h1>规则书</h1><p class="lede">按原书顺序阅读的入口。PHB、DMG 与 MM 已接入现有中文工作译稿；其他书目继续保留入口。</p><div class="book-list">{books.map((book) => <article class="book-row"><div class="book-code">{book.short}</div><div><h3><a href={`/books/${book.id}`}>{book.titleZh}</a></h3><p>{book.description} {published.some((topic) => topic.book === book.id) && `已发布 ${published.filter((topic) => topic.book === book.id).length} 篇。`}</p></div></article>)}</div></BaseLayout>
