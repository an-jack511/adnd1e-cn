---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bookshelf from '../../components/Bookshelf.astro';
import { libraryBooks, libraryCategories } from '../../data/bookshelf';
---
<BaseLayout title="图书馆">
  <header class="shelf-page-heading">
    <h1>图书馆</h1>
    <nav class="shelf-page-links" aria-label="图书馆导航"><a href="/reference/">检索原书章节与表格</a></nav>
  </header>
  <Bookshelf books={libraryBooks} categories={libraryCategories} label="图书馆" />
</BaseLayout>
