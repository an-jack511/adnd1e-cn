---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { books } from '../../data/public/books';
import published from '../../data/published/books.json';
---
<BaseLayout title="规则书"><h1>规则书</h1><p class="download-line"><strong>离线版下载：</strong><a href="https://github.com/an-jack511/adnd1e-cn/releases/download/v0.2.0/ADnD1e-Buquanshu-GPT-v0.2.0.chm">AD&amp;D 1e 不全书（GPT v0.2.0，CHM，约 305 MB）</a></p><div class="book-list">{books.filter((book) => published.some((topic) => topic.book === book.id)).map((book) => <article class="book-row"><div class="book-code">{book.short}</div><div><h3><a href={`/books/${book.id}`}>{book.titleZh}</a></h3><p>{published.filter((topic) => topic.book === book.id).length} 篇 · {book.description}</p></div></article>)}</div></BaseLayout>
