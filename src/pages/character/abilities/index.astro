---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import tables from '../../../data/public/ability-tables.json';
const names: Record<string, string> = { STR: '力量', INT: '智力', WIS: '感知', DEX: '敏捷', CON: '体质', CHA: '魅力' };
const entries = Object.entries(tables);
---
<BaseLayout title="人物属性表">
  <h1>人物属性表</h1>
  <p>按《玩家手册》属性表列示。非凡力量 18/xx 只适用于符合资格的人物；具体检定仍须按相应职业和情境处理。</p>
  <p>{entries.map(([key], index) => <span><a href={`#${key.toLowerCase()}`}>{names[key]} {key}</a>{index < entries.length - 1 ? ' · ' : ''}</span>)}</p>
  {entries.map(([key, table]) => <section id={key.toLowerCase()}><h2>{names[key]} {key}</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>属性值</th>{table.labels.map((label) => <th>{label}</th>)}</tr></thead><tbody>{table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div><p class="small">来源：<a href="/books/phb/group-04/">PHB 角色属性</a> p.{table.page}</p></section>)}
  <p><a href="/character/">返回人物卡</a></p>
</BaseLayout>
