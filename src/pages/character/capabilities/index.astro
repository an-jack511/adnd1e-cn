---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="核心职业能力 · 角色系统">
  <h1>核心职业能力</h1>
  <p>选择职业和等级，查看 PHB 核心十职业的能力、限制、据点与追随者条件。</p>
  
  <section class="filters" aria-label="职业与等级">
    <label>职业 <select id="cap-class"></select></label>
    <label>等级 <input id="cap-level" type="number" min="1" step="1" value="1" /></label>
  </section>
  <p id="cap-summary" role="status" aria-live="polite"></p>
  <section><h2>当前生效</h2><div id="cap-active" class="capability-grid"></div></section>
  <details><summary>以后等级解锁</summary><ul id="cap-locked"></ul></details>
  <script>import {startClassCapabilityBrowser} from '../../../character/ui/class-capability-controller';startClassCapabilityBrowser();</script>
</BaseLayout>
<style>
  .filters{display:flex;flex-wrap:wrap;gap:1rem}.filters label{display:flex;flex-direction:column;gap:.25rem}.filters select,.filters input{min-height:44px;font:inherit}
  .capability-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.capability{border:1px solid #aaa;padding:1rem}.capability h3{margin-top:0}
  .capability-needs-dm{border-left:5px solid #9a661b}.capability-unsupported{border-left:5px solid #8b2020}.small{font-size:.9rem;color:#555}
  @media(max-width:700px){.capability-grid{grid-template-columns:1fr}}
</style>
