---
import '../../../styles/character-prototype.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="创建角色 · 核心资格与开局任务" noIndex bodyClass="create-workspace" createStage="core"><div class="legacy-character-tools">
<nav class="character-subnav" aria-label="角色主导航"><a href="/character/">人物卡</a></nav>
<header class="workbar"><span>创建角色 · 第二阶段 / 核心创建进度</span><div><button id="core-save-local" type="button">保存进度</button><button id="core-export" type="button" disabled>导出进度</button></div></header>
<section id="create-workspace" tabindex="-1" data-creation-navigation><div class="page-heading"><p class="eyebrow">创建角色 · 第二阶段</p><h1>确定身份，逐项准备入场</h1><p>先选择种族与职业，再记录开局项目。</p></div><details class="create-resume"><summary>继续本地进度或导入创建文件</summary><div class="create-action-row"><label>本地创建进度<select id="core-saved"><option value="">选择浏览器保存的进度</option></select></label><button id="core-load-local" type="button">加载本地进度</button><label class="file-button">导入创建文件<input id="core-import" type="file" accept="application/json,.json" /></label></div><p>导入后身份选择保持锁定，可以继续未完成事项。当前已有进度时，请先导出备份，再按现有流程重新打开；不同身份请重新创建。</p></details><p id="core-status" class="app-status create-live-status" role="status" aria-live="polite">尚未检查核心资格。</p><div class="creation-layout create-layout"><div class="step-list create-step-list" role="tablist" aria-label="创建步骤"><button type="button" role="tab" id="create-tab-identity" data-create-tab="identity" aria-controls="create-panel-identity" aria-selected="true" tabindex="0"><span>01</span>身份资格</button><button type="button" role="tab" id="create-tab-resources" data-create-tab="resources" aria-controls="create-panel-resources" aria-selected="false" tabindex="-1"><span>02</span>生命与资金</button><button type="button" role="tab" id="create-tab-languages" data-create-tab="languages" aria-controls="create-panel-languages" aria-selected="false" tabindex="-1"><span>03</span>语言</button><button type="button" role="tab" id="create-tab-proficiencies" data-create-tab="proficiencies" aria-controls="create-panel-proficiencies" aria-selected="false" tabindex="-1"><span>04</span>武器熟练</button><button type="button" role="tab" id="create-tab-equipment" data-create-tab="equipment" aria-controls="create-panel-equipment" aria-selected="false" tabindex="-1"><span>05</span>装备采购</button><button type="button" role="tab" id="create-tab-spells" data-create-tab="spells" aria-controls="create-panel-spells" aria-selected="false" tabindex="-1"><span>06</span>初始法术</button><button type="button" role="tab" id="create-tab-admission" data-create-tab="admission" aria-controls="create-panel-admission" aria-selected="false" tabindex="-1"><span>07</span>战役约定</button><button type="button" role="tab" id="create-tab-review" data-create-tab="review" aria-controls="create-panel-review" aria-selected="false" tabindex="-1"><span>08</span>检查与保存</button></div><div class="create-step-content"><section class="paper-section create-step-panel" id="create-panel-identity" data-create-panel="identity" role="tabpanel" aria-labelledby="create-tab-identity" ><h2 tabindex="-1">选择属性草稿与核心身份</h2><p>选择已保存的属性草稿，检查种族与职业资格。</p><section aria-label="核心角色候选">
  
    <div class="fields"><label>属性草稿 <select id="core-draft"><option value="">选择已确认属性草稿</option></select></label><label>种族 <select id="core-race"></select></label><label>亚种 <select id="core-subrace"></select></label><label>性别（用于原表上限） <select id="core-sex"><option value="male">男性</option><option value="female">女性</option></select></label><label>阵营 <select id="core-alignment"></select></label><label>职业模式 <select id="core-mode"><option value="single">单职业</option><option value="multiclass">同时多职业</option></select></label></div>
    <fieldset class="character-profile-fields"><legend>人物资料（可选）</legend><div class="fields"><label>背景简介 <textarea id="core-background" rows="5" maxlength="12000" placeholder="出身、经历、目标、关系……"></textarea></label><label>人物肖像 <input id="core-portrait" type="file" accept="image/*" /><small>图片会随创建文件保存；建议使用 1.5 MiB 以内的图片。</small></label></div><img id="core-portrait-preview" class="character-portrait-preview" alt="人物肖像预览" hidden /></fieldset>
    <fieldset><legend>普通核心职业</legend><div id="core-classes" class="choices"></div></fieldset>
    <button id="core-evaluate" type="button">检查核心资格</button>

    <div id="core-results" class="scores" aria-label="调整后属性"></div><ul id="core-issues"></ul>
  </section><p><a href="/character/create/">返回属性阶段 →</a></p><p class="inline-note">点击“下一步”记录生命、资金、语言、武器熟练和起始装备。</p></section><section class="paper-section create-step-panel" id="create-panel-resources" data-create-panel="resources" role="tabpanel" aria-labelledby="create-tab-resources" ><h2 tabindex="-1">生命与资金</h2><p class="create-step-empty" data-create-empty="core-resources">先在“身份资格”选择属性草稿、种族与职业，并检查资格。允许继续后，此处显示对应任务；需要战役现场决定的事项会保留。</p><section id="core-resources" aria-label="一级生命值与起始金钱" hidden>
    <h2>一级生命值与起始金钱</h2>
    <p class="notice">可在线掷骰，也可输入桌上掷出的点数。</p>
    <div class="resource-grid">
      <div><h3>一级 HP</h3><p id="core-hp-help"></p><label>掷骰方式 <select id="core-hp-faces-mode"><option value="browser">浏览器掷骰</option><option value="manual">手工录入</option></select></label><div id="core-hp-class-rolls"></div><button id="core-hp-record" type="button">掷骰并记录 HP</button></div>
      <div><h3>起始金钱</h3><p id="core-money-help"></p><label>掷骰方式 <select id="core-money-faces-mode"><option value="browser">浏览器掷骰</option><option value="manual">手工录入</option></select></label><label>骰面（逗号分隔） <input id="core-money-faces" inputmode="numeric" /></label><button id="core-money-record" type="button">掷骰并记录金钱</button></div>
    </div>
    <p id="core-resource-status" role="status" aria-live="polite">先完成核心资格检查。</p>
  </section></section>
<section class="paper-section create-step-panel" id="create-panel-languages" data-create-panel="languages" role="tabpanel" aria-labelledby="create-tab-languages" ><h2 tabindex="-1">语言</h2><p class="create-step-empty" data-create-empty="core-languages">先在“身份资格”选择属性草稿、种族与职业，并检查资格。允许继续后，此处显示对应任务；需要战役现场决定的事项会保留。</p><section id="core-languages" aria-label="角色语言" hidden>
    <h2>语言与特殊交流</h2>
    <p class="notice">额外语言由 DM 确认可学范围与学习时间。</p>
    <p id="core-language-automatic"></p><div id="core-language-slots"></div>
    <button id="core-language-record" type="button">检查并记录语言</button>
    <p id="core-language-status" role="status" aria-live="polite"></p>
  </section></section>
<section class="paper-section create-step-panel" id="create-panel-proficiencies" data-create-panel="proficiencies" role="tabpanel" aria-labelledby="create-tab-proficiencies" ><h2 tabindex="-1">武器熟练</h2><p class="create-step-empty" data-create-empty="core-proficiencies">先在“身份资格”选择属性草稿、种族与职业，并检查资格。允许继续后，此处显示对应任务；需要战役现场决定的事项会保留。</p><section id="core-proficiencies" hidden aria-label="开局武器熟练">
    <h2>开局武器熟练</h2>
    <p>PHB p.37：按职业分配开局武器熟练位。选择具体武器后，系统检查职业许可。其他武器可以手工记录，留待战役确认；一项熟练不会授予整类武器。</p>
    <p id="core-proficiency-help"></p><div id="core-proficiency-choices"></div>
    <button id="core-proficiency-record" type="button">检查并记录熟练</button>
    <p id="core-proficiency-status" role="status" aria-live="polite"></p>
  </section></section>
<section class="paper-section create-step-panel" id="create-panel-equipment" data-create-panel="equipment" role="tabpanel" aria-labelledby="create-tab-equipment" ><h2 tabindex="-1">装备采购</h2><p class="create-step-empty" data-create-empty="core-starting-equipment">先在“身份资格”选择属性草稿、种族与职业，并检查资格。允许继续后，此处显示对应任务；需要战役现场决定的事项会保留。</p><section id="core-starting-equipment" aria-label="初始装备"></section></section>
<section class="paper-section create-step-panel" id="create-panel-spells" data-create-panel="spells" role="tabpanel" aria-labelledby="create-tab-spells" ><h2 tabindex="-1">初始法术</h2><p class="create-step-empty" data-create-empty="core-initial-spells">先在“身份资格”选择属性草稿、种族与职业，并检查资格。允许继续后，此处显示对应任务；需要战役现场决定的事项会保留。</p><section id="core-initial-spells" aria-label="初始法术"></section></section>
<section class="paper-section create-step-panel" id="create-panel-admission" data-create-panel="admission" role="tabpanel" aria-labelledby="create-tab-admission" ><h2 tabindex="-1">战役约定</h2><p class="create-step-empty" data-create-empty="core-campaign-admission">先在“身份资格”选择属性草稿、种族与职业，并检查资格。允许继续后，此处显示对应任务；需要战役现场决定的事项会保留。</p><section id="core-campaign-admission" aria-label="战役入场与灵能"></section></section><section class="paper-section create-step-panel" id="create-panel-review" data-create-panel="review" role="tabpanel" aria-labelledby="create-tab-review" ><h2 tabindex="-1">核对事项，保存并继续</h2><p>点击各项的“记录”后，可在此核对。</p><p data-create-task-count>先完成核心资格检查。</p><ul class="create-task-list" data-create-tasks></ul><div class="create-action-row"><button type="button" data-create-save>仅保存创建进度</button></div><details><summary>规则与记录</summary><ul id="core-task-summary"></ul><a href="/books/phb/">查看 PHB 目录 →</a></details></section><div class="wizard-footer create-step-footer"><button type="button" data-create-prev>上一步</button><span data-create-position></span><button type="button" class="primary" data-create-next>下一步</button></div></div><aside class="context-panel create-summary" aria-label="当前人物摘要"><p class="eyebrow">人物草稿 · 当前可见记录</p><h2 data-create-name>未命名草稿</h2><p data-create-identity>尚未选择核心身份</p><div class="create-score-summary" data-create-scores></div><p class="muted">属性以资格检查结果为准；选择改变后须重新检查。</p><h3>已记录事项</h3><p data-create-task-count>先完成核心资格检查。</p><ul class="create-task-list" data-create-tasks></ul><details><summary>备份</summary><p>切换步骤前保存进度。</p><a href="/character/import/">未知格式与原件隔离检查 →</a></details></aside></div></section>
<noscript>请启用 JavaScript 以使用车卡。</noscript>
<script>import { startCoreCandidate } from '../../../character/ui/core-candidate-controller'; import { startCreationStepNavigation } from '../../../character/ui/creation-step-navigation'; startCoreCandidate(); startCreationStepNavigation();</script>
<script>/* 兼容旧版创建进度；当前玩家端不提供审核入口。 */</script>
<script>
  const heading = document.querySelector<HTMLElement>('.page-heading h1');
  if (heading) heading.textContent = '确定身份，准备开局';
  const intro = heading?.nextElementSibling;
  if (intro) intro.textContent = '先选身份，再补齐生命、资金、语言、熟练、装备和法术。';
  const admission = document.querySelector<HTMLElement>('#create-panel-admission h2');
  if (admission) admission.textContent = '可选规则与战役设置';
  const review = document.querySelector<HTMLElement>('#create-panel-review h2');
  if (review) review.textContent = '核对事项，保存';
  const identityNote = document.querySelector<HTMLElement>('#create-panel-identity h2 + p');
  if (identityNote) identityNote.textContent = '从已确认的六项属性继续。选好种族、职业和阵营后，下面的开局任务会直接展开。';
  const reviewNote = document.querySelector<HTMLElement>('#create-panel-review h2 + p');
  if (reviewNote) reviewNote.textContent = '只显示已经记录的创建事项；没有填完的内容会清楚标成待补充。';
  const reviewSaveNote = document.querySelector<HTMLElement>('#create-panel-review [data-create-save] + p');
  if (reviewSaveNote) reviewSaveNote.textContent = '导出角色文件，备份创建进度。';
  const reviewSaveNoteWrapped = document.querySelector<HTMLElement>('#create-panel-review .create-action-row + p');
  if (reviewSaveNoteWrapped) reviewSaveNoteWrapped.textContent = '导出角色文件，备份创建进度。';
  document.querySelector<HTMLElement>('#create-panel-review [data-create-save]')?.closest('.create-action-row')?.remove();
  const reviewActions = document.querySelector<HTMLElement>('#create-panel-review .create-action-row');
  if (reviewActions && !document.getElementById('core-enter-sheet')) {
    const action = document.createElement('div');
    action.className = 'create-action-row';
    action.innerHTML = '<button type="button" id="core-enter-sheet" class="primary" disabled>保存并打开角色卡</button>';
    reviewActions.before(action);
  }
  if (!document.getElementById('core-enter-sheet')) {
    const reviewPanel = document.querySelector<HTMLElement>('#create-panel-review');
    const action = document.createElement('div');
    action.className = 'create-action-row';
    action.innerHTML = '<button type="button" id="core-enter-sheet" class="primary" disabled>保存并打开角色卡</button>';
    reviewPanel?.querySelector('details')?.before(action);
  }
  const reviewEntryNote = document.querySelector<HTMLElement>('#create-panel-review .create-action-row + p');
  if (reviewEntryNote) reviewEntryNote.textContent = '未完成事项会保留在角色卡中；可导出角色文件备份。';
  const identityTaskNote = document.querySelector<HTMLElement>('#create-panel-identity .inline-note');
  if (identityTaskNote) identityTaskNote.textContent = '检查通过后，下面的开局任务会直接展开；没有完成的事项会显示为待补充。';
  const navNote = document.querySelector<HTMLElement>('.nav-foot p');
  if (navNote) navNote.textContent = '保留骰点与创建依据；完成后可导出自己的角色文件。';
  const reviewNumber = document.querySelector<HTMLElement>('#create-tab-review span');
  if (reviewNumber) reviewNumber.textContent = '07';
  document.querySelectorAll<HTMLElement>('#create-workspace *').forEach(node => {
    if (node.childElementCount !== 0 || !node.textContent) return;
    node.textContent = node.textContent.replace(/一级 HP/g, '一级生命值').replace(/HP/g, '生命值').replace(/XP/g, '经验值').replace(/STR/g, '力量').replace(/INT/g, '智力').replace(/WIS/g, '智慧').replace(/DEX/g, '敏捷').replace(/CON/g, '体质').replace(/CHA/g, '魅力');
  });
</script>
</div></BaseLayout>
