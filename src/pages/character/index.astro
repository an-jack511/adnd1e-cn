---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Field from '../../components/Ref2Field.astro';
import Repeater from '../../components/Ref2Repeater.astro';
import type {Column} from '../../components/Ref2Row.astro';
import { classes } from '../../data/public/classes';
import { races } from '../../data/public/races';
import '../../styles/ref2.css';
const abilities=[['STR','力量'],['INT','智力'],['WIS','感知'],['DEX','敏捷'],['CON','体质'],['CHA','魅力']];
const saveNames=['麻痹／毒素','石化／变形','权杖／法杖／魔杖','吐息武器','法术'];
const raceOptions=races.filter(race=>race.characterEligible!==false).map(race=>({value:race.id,label:race.nameZh+(race.referenceOnly?'（扩展）':'')}));
const classOptions=classes.filter(entry=>entry.characterEligible!==false).map(entry=>({value:entry.id,label:entry.nameZh+(entry.source[0]?.book==='OA'?'（OA）':entry.referenceOnly?'（扩展）':'')}));
const weapons:Column[]=[{key:'name',label:'武器',class:'wide-cell'},{key:'base_weapon',label:'基础武器（选填）'},{key:'mode',label:'方式',options:[{value:'handHeld',label:'手持'},{value:'missile',label:'投掷／射击'}]},{key:'attacks',label:'攻击次数'},{key:'hit',label:'命中／伤害调整',pair:{key:'damage_adj',label:'伤害调整'}},{key:'thac0',label:'THAC0'},...Array.from({length:11},(_,index)=>({key:`ac_${10-index}`,label:String(10-index),class:'ac-cell'})),{key:'sm',label:'伤害 S-M／L',pair:{key:'large',label:'对大型目标伤害'}},{key:'notes',label:'射程／特殊',class:'wide-cell'}];
const unarmed:Column[]=[{key:'style',label:'流派'},{key:'form',label:'攻击形式'},{key:'ac',label:'AC 调整'},{key:'attacks',label:'攻击次数'},{key:'hit',label:'命中／伤害调整',pair:{key:'damage_adj',label:'伤害调整'}},{key:'thac0',label:'THAC0'},{key:'damage',label:'伤害／效果'},{key:'maneuvers',label:'特殊招式'}];
const gear:Column[]=[{key:'item',label:'物品',class:'wide-cell'},{key:'location',label:'携带位置'},{key:'quantity',label:'数量',type:'number'},{key:'size',label:'体积'}];
const family:Column[]=[{key:'name',label:'姓名／关系',class:'wide-cell'},{key:'age',label:'年龄'},{key:'status',label:'身份'},{key:'profession',label:'职业'},{key:'reaction',label:'态度 RX'}];
const henchmen:Column[]=[{key:'name',label:'姓名',class:'wide-cell'},{key:'ac',label:'AC'},{key:'raceClass',label:'种族 / 职业'},{key:'level',label:'HD / 等级'},{key:'attacks',label:'攻击次数'},{key:'thac0',label:'THAC0'},{key:'damage',label:'伤害／效果'},{key:'hp',label:'HP'},{key:'abilities',label:'技艺／能力',class:'wide-cell'}];
---
<BaseLayout title="人物卡" description="REF2 风格中文人物卡：属性、战斗、装备、随从与准备法术。">
<div class="ref2-workspace">
  <header class="card-workspace-heading"><div><h1>人物卡</h1><p>人物记录与法术计划</p></div><p><a href="/character/help/">使用帮助</a> · <a href="/character/abilities/">属性表</a></p></header>
  <div class="ref2-toolbar character-toolbar" aria-label="人物卡操作">
    <div class="character-toolbar-record">
      <label class="character-toolbar-choice"><span>人物</span><select id="saved-characters" aria-label="浏览器保存的人物"><option value="">未选择已保存人物</option></select></label>
      <button type="button" id="load-character">载入</button><button type="button" id="new-character">新建</button><button type="button" id="save-character">保存</button>
    </div>
    <div class="character-toolbar-paper">
      <label class="character-toolbar-choice"><span>样式</span><select id="exact-print-style"><option value="ref2">REF2 人物记录表</option><option value="permanent">永久人物记录表</option></select></label>
      <button type="button" id="print-ref2-character">打印当前样式</button>
    </div>
    <details class="ref2-print-settings character-toolbar-more screen-tools">
      <summary>更多设置</summary>
      <div class="character-toolbar-options">
        <div><label>填写字体 <select id="entry-font"><option value="hand">霞鹜文楷</option><option value="song">宋体</option><option value="custom">本机字体</option></select></label><input id="entry-font-custom" type="text" aria-label="本机字体名称" placeholder="输入本机字体名称" maxlength="80" hidden /></div>
        <div><span class="character-option-label">文件</span><button type="button" id="copy-character">另存副本</button><button type="button" id="export-character">导出 JSON</button><label class="file-button">导入 JSON<input id="import-character" type="file" accept=".json,application/json" /></label></div>
        <div><span class="character-option-label">复刻表</span><button type="button" id="preview-ref2-character">预览复刻表</button><a href="/character/ref2/">空白 REF2 PDF</a><a href="/character/permanent/">空白永久表 PDF</a></div>
        <div><span class="character-option-label">扩展记录</span><button type="button" id="print-character">打印</button><button type="button" id="preview-character">预览</button><label><input type="checkbox" id="print-monochrome" /> 黑白</label><label><input type="checkbox" id="print-compact" /> 压缩空栏</label></div>
      </div>
    </details>
  </div>
  <p id="character-status" class="card-status" role="status" aria-live="polite">填写后点击“保存”，或导出 JSON 备份。</p>
  <nav class="ref2-tabs character-page-tabs" aria-label="人物卡页面">{[1,2,3,4].map(i=><button class="permanent-tab" type="button" data-permanent-page={i} aria-pressed="false">第 {i} 面</button>)}<button class="permanent-tab" type="button" data-card-tab="rules" aria-pressed="false">规则与装备</button><button type="button" data-card-tab="front" aria-pressed="true">正面 · 常用数据</button><button type="button" data-card-tab="back" aria-pressed="false">背面 · 人物与物资</button><button type="button" data-card-tab="spells" aria-pressed="false">准备法术 <span id="prepared-count">0</span></button><a class="ref2-tab-link" href="/character/spellbooks/">法术书</a><button type="button" data-card-tab="all" aria-pressed="false">整卡</button></nav>
  <button type="button" id="show-permanent-layout" class="screen-tools" hidden>永久人物表</button>
  <section id="permanent-layout" class="screen-tools" aria-label="可填写永久人物表" hidden>
    <p>可在表中直接填写。种族、职业和装备资料库可在“规则与装备”编辑。</p>
    <iframe id="permanent-editor" title="可填写永久人物表"></iframe>
  </section>
  <form id="character-form" class="ref2-card" autocomplete="off">
    <input name="character_id" type="hidden" />
    <section class="ref2-paper ref2-front" data-card-panel="front" aria-label="人物卡正面">
      <header class="ref2-paper-head"><div class="ref2-identifiers"><Field name="name" label="人物姓名" class="character-name" /><div class="identity-line"><Field name="alignment" label="阵营" options={[['LG','守序善良'],['NG','中立善良'],['CG','混乱善良'],['LN','守序中立'],['TN','绝对中立'],['CN','混乱中立'],['LE','守序邪恶'],['NE','中立邪恶'],['CE','混乱邪恶']].map(([value,label])=>({value,label}))} /><Field name="race" label="种族" options={raceOptions} /><Field name="class" label="职业" options={classOptions} /><Field name="level" label="等级" type="number" value="1" /></div></div><div class="ref2-wordmark"><img class="ref2-original-logo" src="/images/ref2/adnd-logo.svg" width="1188" height="240" alt="Advanced Dungeons &amp; Dragons" /><span>高级龙与地下城 · 第一版</span><h2>人物记录</h2></div></header>
      <div class="identity-library-actions"><button type="button" data-open-identity="races">从资料库选择种族</button><button type="button" data-open-identity="classes">从资料库选择职业</button></div>
      <div class="ref2-top-grid">
        <section class="ref2-abilities"><h3>属性 <small>ABILITIES</small></h3>
          {abilities.map(([key,label])=><div class="ability-row">{key==='STR'?<div class="strength-score"><input name={key} aria-label={`${label}数值`} inputmode="text" /><label id="exceptional-row" class="exceptional" hidden><input name="exceptional_strength" inputmode="numeric" placeholder="01–00" aria-label="超凡力量百分数" /></label></div>:<input name={key} aria-label={`${label}数值`} inputmode="numeric" />}<b>{key}<span>{label}</span></b><div data-derived={key} class="ability-derived">—</div></div>)}
          <div class="ability-row comeliness"><input name="CMS" aria-label="容貌数值" inputmode="numeric" /><b>CMS<span>容貌</span></b><Field name="comeliness_response" label="反应" /></div>
          <details class="card-calculation-tools" open><summary>第 1 步：生成六项属性</summary><p>新手可选 DMG 方法 I（每项掷 4d6、去掉最低骰），再把六个结果分配给属性。其他三种方法也可选；掷完后仍可手动调整分配。</p><label class="ref2-field"><span>属性生成方法（DMG）</span><select name="ability_method"><option value="I">方法 I：六项各掷 4d6，去最低</option><option value="II">方法 II：掷 12 组 3d6，取最高 6 组</option><option value="III">方法 III：每项各掷 6 次 3d6，取最高</option><option value="IV">方法 IV：生成 12 组完整属性，挑一组</option></select></label><label id="ability-roll-group-wrap" class="ref2-field" hidden><span>选择完整属性组</span><select id="ability-roll-group"></select></label><button type="button" id="roll-abilities">按所选方法掷骰</button><p id="ability-roll-result" role="status" aria-live="polite"></p><label class="checkline"><input name="dm_override" type="checkbox" /> 手动覆盖资格限制</label></details>
        </section>
        <section class="ref2-honor"><h3>荣誉 <small>HONOR</small></h3><div class="honor-ovals"><Field name="honor" label="当前" type="number" class="honor-current" /><Field name="honor_base" label="基础" type="number" class="honor-base" /></div><Field name="reactionHonor" label="反应调整" type="textarea" rows={2} /><Field name="resistances" label="抗性／免疫" type="textarea" rows={3} /></section>
        <section class="ref2-saves"><h3>豁免检定 <small>SAVING THROWS</small></h3><div class="save-labels"><span>调整原因</span><span>调整值</span><span>类别</span><span>目标值</span></div>{saveNames.map((label,index)=><div class="save-row"><input name={`save_note_${index}`} aria-label={`${label}调整原因`} /><input name={`save_modifier_${index}`} aria-label={`${label}调整值`} /><span>{label}</span><input class="save-circle" name={`save_${index}`} aria-label={`${label}目标值`} inputmode="numeric" /></div>)}<label class="checkline"><input name="manual_saves" type="checkbox" /> 手动豁免</label><p id="save-breakdown" class="card-source"></p></section>
      </div>
      <section class="ref2-senses-movement">
        <div class="senses-row"><div><Field name="senses" label="视觉" /><Field name="detections" label="侦测" /></div><Field name="languages" label="语言" type="textarea" rows={2} /></div>
        <div class="movement-row"><div class="movement-base"><h3>移动</h3><div class="movement-summary"><Field name="move_base" label="基础移动率" readonly /><Field name="move_loaded" label="实际移动率" readonly /></div></div><div class="movement-rates">{[['hvy','重负 ×¾'],['load','负重 ×½'],['max','极限 ×¼'],['run_rate','奔跑 ×10'],['normal_rate','通常 ×5'],['crawl','爬行 ×½'],['day','每日'],['hidden','潜行／险地 ×⅔'],['swim','游泳']].map(([key,label])=><Field name={`move_${key}`} label={label} readonly={!['day','swim'].includes(key)} />)}</div><Field name="move_special" label="特殊移动" type="textarea" rows={3} /></div>
        <details class="card-calculation-tools"><summary>负重与移动调整</summary><div class="adjustment-fields"><Field name="coins_carried" label="携带钱币总数（自动合计）" type="number" value="0" readonly /><Field name="move_adjustment" label="其他移动调整（寸）" type="number" value="0" /><label class="checkline"><input name="move_bulky" type="checkbox" /> 体积／笨重：上调一档</label><label class="checkline"><input name="move_terrain" type="checkbox" /> 地形使移动减半</label><label class="checkline"><input name="manual_movement" type="checkbox" /> 手动填写实际移动率</label></div><p id="movement-breakdown"></p></details>
      </section>
      <div class="ref2-defense-grid"><section class="ref2-armor"><div class="armor-emblem"><h3>护甲</h3><div class="armor-shield"><svg viewBox="0 0 80 88" aria-hidden="true"><path d="M3 2H77C76 38 66 68 40 84C14 68 4 38 3 2Z" fill="none" stroke="currentColor" stroke-width="3" /></svg><Field name="ac" label="AC" readonly /></div></div><div class="armor-fields"><div class="screen-tools"><button type="button" data-open-item-library="armor">选取护甲</button><button type="button" data-open-item-library="shield">选取盾牌</button></div><Field name="armor_item" label="护甲／部件" /><Field name="shield_item" label="盾牌" /><div class="armor-variants"><Field name="ac_surprised" label="突袭时" /><Field name="ac_shieldless" label="无盾" /><Field name="ac_rear" label="背后" /></div><Field name="defenses" label="防御能力" /></div><details class="card-calculation-tools"><summary>AC 调整</summary><Field name="ac_modifier" label="其他 AC 调整" type="number" value="0" /><label class="checkline"><input type="checkbox" name="manual_ac" /> 手动填写 AC</label><p id="ac-breakdown"></p></details></section><section class="ref2-hitpoints"><div><h3>生命值</h3><Field name="hp_max" label="最大" /><Field name="hp_current" label="当前" /></div><Field name="wounds" label="伤势记录" type="textarea" rows={4} /></section></div>
      <p id="combat-breakdown" class="card-source"></p><label class="checkline"><input type="checkbox" name="auto_weapon_proficiency" checked /> 自动计算专精奖励与不熟练惩罚</label><label class="checkline"><input type="checkbox" name="manual_combat" /> 手动填写武器战斗数值</label><Repeater name="weapons" title="武器战斗" english="WEAPON COMBAT" columns={weapons} tone="orange" />
      <div class="combat-notes"><Field name="special_attacks" label="特殊攻击" type="textarea" rows={2} /><div><Repeater name="ammunition" title="弹药／消耗品" columns={[{key:'name',label:'物品'},{key:'count',label:'总数',type:'number'},{key:'used',label:'已用',type:'number'}]} compact /><Field name="ammunition" label="弹药附注" /></div></div>
      <Repeater name="unarmed" title="徒手战斗" english="UNARMED COMBAT" columns={unarmed} tone="yellow" />
      <div class="ref2-special-grid"><div><button type="button" data-open-item-library="magic">＋ 选取魔法物品</button><p class="card-source">武器自动列入战斗栏；敏捷手套、食人魔力量护手及防护物品自动计入属性、命中、伤害、AC 与豁免。可关闭单件效果。</p><div id="owned-magic-items" class="owned-magic-items"></div><Field name="magic_items" label="魔法物品附注" type="textarea" rows={6} /></div><div class="proficiencies-column"><details class="card-calculation-tools"><summary>熟练项栏位设置</summary><Field name="proficiency_rules" label="栏位规则" options={[{value:'auto',label:'按职业：西方 WSG／DSG，东方 OA'},{value:'phb',label:'PHB 武器熟练'},{value:'wsg',label:'WSG／DSG（可选）'},{value:'oa',label:'OA 共用栏位'}]} /><Field name="weapon_slots" label="武器总栏位" /><Field name="nonweapon_slots" label="非武器总栏位" /><Field name="shared_slots" label="OA 共用总栏位" /><Field name="weapon_slots_to_nonweapon" label="武器栏转非武器栏" type="number" /></details><p id="proficiency-budget" class="card-source"></p><Repeater name="proficiencies" lanes={2} title="熟练项／技艺" columns={[{key:'name',label:'名称'},{key:'weaponRank',label:'武器熟练度',options:[{value:'proficient',label:'熟练'},{value:'specialized',label:'专精'},{value:'untrained',label:'不熟练'}]},{key:'ability',label:'属性'},{key:'modifier',label:'调整'},{key:'slots',label:'占栏'}]} tone="orange" compact /><Field name="proficiencies" label="技艺附注" type="textarea" rows={2} /></div><Field name="special_abilities" label="特殊能力" type="textarea" rows={10} /></div>
      <footer class="ref2-page-foot"><span data-mirror="name"></span><span>REF2 · 人物记录 · 正面</span></footer>
    </section>
    <section class="ref2-paper ref2-back" data-card-panel="back" aria-label="人物卡背面" hidden>
      <h2 class="ref2-description-title">人物描述 <small>DESCRIPTION</small></h2>
      <div class="description-grid"><div><label class="ref2-field"><span>姓名</span><output data-mirror="name"></output></label><Field name="homeland" label="故乡" /><div class="description-pairs"><Field name="sex" label="性别" /><Field name="age" label="年龄" /><Field name="height" label="身高" /><Field name="weight" label="体重" /><Field name="hair" label="发色" /><Field name="eyes" label="瞳色" /></div><button type="button" id="roll-age">按 DMG 骰年龄</button></div><div><Field name="family" label="家族" /><Field name="liege" label="领主／资助者" /><Field name="social_status" label="社会阶层" options={[{value:'奴隶／依附者',label:'奴隶／依附者'},{value:'农民／平民',label:'农民／平民'},{value:'自由民／手艺人',label:'自由民／手艺人'},{value:'商人／富裕市民',label:'商人／富裕市民'},{value:'小贵族／骑士家系',label:'小贵族／骑士家系'},{value:'贵族',label:'贵族'},{value:'王族／统治家系',label:'王族／统治家系'},{value:'宗教阶层',label:'宗教阶层'},{value:'其他',label:'其他'}]} /><Field name="birth_rank" label="排行" /><Field name="appearance" label="外貌" /></div><div><Field name="clan" label="种族／氏族" /><Field name="religion" label="宗教" /><Field name="status" label="地位" /><Field name="siblings" label="兄弟姐妹数" type="number" /><Field name="height_weight" label="身高／体重附注" /><Field name="hair_eyes" label="发色／瞳色附注" /></div></div>
      <div class="description-notes"><Field name="personality" label="性格（习惯／恐惧／厌恶／愿望）" type="textarea" rows={3} /><Field name="history" label="经历（塑造人生的事件）" type="textarea" rows={3} /></div>
      <div class="ref2-gear-supplies"><Repeater name="gear" lanes={3} title="装备" english="GEAR" columns={gear} note="note" noteLabel="备注" tone="yellow" /><section class="ref2-supplies"><h3 class="ref2-band yellow">补给 <small>SUPPLIES</small></h3>{[["water","水／酒",20],["rations","口粮",40],["feed","饲料",30]].map(([key,label,count])=><div class="supply-stock"><Field name={`supplies_${key}`} label={String(label)} /><div class="supply-boxes" role="group" aria-label={`${label}消耗记录`}>{Array.from({length:Number(count)},(_,index)=><input type="checkbox" name={`supplies_${key}_${index}`} aria-label={`${label}第 ${index+1} 份已用`} />)}</div></div>)}<p id="encumbrance-result"></p></section></div>

      <div class="ref2-rewards"><section><h3>经验</h3><Field name="xp" label="经验值" /><Field name="experience_notes" label="经验记录" type="textarea" rows={6} /></section><section class="treasure-section"><h3>财宝</h3><div class="coin-denominations" aria-label="钱币数量"><Field name="coins_gp" label="gp 金币" type="number" value="0" /><Field name="coins_sp" label="sp 银币" type="number" value="0" /><Field name="coins_cp" label="cp 铜币" type="number" value="0" /><Field name="coins_ep" label="ep／异界币" type="number" value="0" /><Field name="coins_pp" label="pp 铂金币" type="number" value="0" /><Field name="coins_dl_steel" label="DL 钢币" type="number" value="0" /><Field name="coins_other_name" label="其他币种" /><Field name="coins_other_count" label="数量" type="number" value="0" /><Field name="coins_other_weight_per_10" label="其他币每 10 枚重（磅）" type="number" value="1" /></div><Repeater name="valuables" title="宝石／贵重物品" columns={[{key:'name',label:'物品'},{key:'quantity',label:'数量'},{key:'size',label:'体积'},{key:'worth',label:'价值'}]} compact /><Field name="treasure_valuables" label="财宝附注" /></section></div>
      <Repeater name="family" lanes={2} title="家人与重要人物" english="FAMILY" columns={family} tone="orange" /><Field name="family_notes" label="人物关系附注" type="textarea" rows={2} />
      <Repeater name="henchmen" title="随从／动物伙伴" english="HENCHMEN / ANIMAL COMPANIONS" columns={henchmen} note="background" noteLabel="背景" tone="yellow" /><Field name="henchmen" label="随从附注" type="textarea" rows={2} />
      <Field name="noteworthy_events" label="值得记录的事件" type="textarea" rows={4} />
      <footer class="ref2-page-foot"><span data-mirror="name"></span><span>REF2 · 人物记录 · 背面</span></footer>
    </section>
    <section class="ref2-paper ref2-spells" data-card-panel="spells" aria-label="准备法术" hidden>
      <header class="planner-heading"><div class="ref2-wordmark"><img class="ref2-original-logo" src="/images/ref2/adnd-logo.svg" width="1188" height="240" alt="Advanced Dungeons &amp; Dragons" /><h2>法术计划 <small>SPELL PLANNER</small></h2></div><div><span>人物：<output data-mirror="name"></output></span><p>每日可准备数量（按职业、等级及属性自动计算）</p><div class="spell-slots">{Array.from({length:10},(_,level)=><Field name={`spell_slots_${level}`} label={level===0?'小法术':`${level}环`} type="number" readonly />)}</div><label class="checkline"><input name="manual_spell_slots" type="checkbox" /> 手动填写法术数量</label><p id="spell-capacity-note" aria-live="polite"></p></div></header>
      <div class="spell-planner-actions"><button type="button" id="open-spell-library">＋ 从法术资料库准备</button><button type="button" id="open-owned-spells">＋ 从法术书／旅行书准备</button><button type="button" id="restore-spells">恢复所有准备次数</button><span id="spell-summary" role="status"></span></div>
      <p id="character-spellbook-summary" class="card-source"></p><p><a href="/character/spellbooks/">查看／编辑法术书与旅行法术书</a></p>
      <p id="prepared-empty">尚未准备法术。</p>
      <button type="button" class="screen-tools" id="print-prepared-spells">打印准备法术页</button><div id="prepared-spells" class="prepared-spells"></div>
      <Field name="spellbook_notes" label="法术书／祈祷记录" type="textarea" rows={4} />
      <p class="card-source">准备次数与剩余次数分开记录；施放后扣除一次。职业、环级与法术位以相应规则书为准。</p>
      <footer class="ref2-page-foot"><span data-mirror="name"></span><span>REF2 · 法术计划</span></footer>
    </section>
  </form>
  <aside class="ref2-rule-check"><h2>实时规则检查</h2><section class="character-first-run" aria-label="新手建卡顺序"><strong>第一次建卡？按这个顺序来：</strong><ol><li>掷六项属性，再按职业要求分配。</li><li>选择阵营、种族、职业和等级；这里会列出冲突与建议。</li><li>到“背面”补经历、钱币和装备；起始资金可按职业掷骰。</li><li>施法者先登记法术书／旅行书，再到“准备法术”选择法术。</li><li>处理红色提示后保存。法术书记录也要单独保存。</li></ol></section><p id="rule-status" role="status"></p><ul id="rule-hints"></ul><section class="rule-suggestions"><h3>创建建议</h3><p id="rule-suggestions"></p><button type="button" id="roll-starting-money">按职业骰起始资金</button><p id="starting-money-result" role="status"></p></section><section class="rule-suggestions"><h3>法术书记录</h3><p id="spellbook-summary">尚未记录法术书。</p><a href="/character/spellbooks/">打开法术书页面</a></section></aside>
  <p class="card-source">版式与栏目：REF2 · Player Character Sheets（1986），PDF 第 3–4 页；法术计划第 5–12 页。</p>
  <dialog id="item-library" aria-label="装备与魔法物品资料库"><header><h2>选取装备与魔法物品</h2><button type="button" id="close-item-library">返回人物卡</button></header><iframe id="item-library-frame" title="选择装备与魔法物品"></iframe></dialog>
  <dialog id="identity-library" aria-label="种族与职业资料库"><header><h2>选择种族</h2><button type="button" id="close-identity-library">返回人物卡</button></header><iframe id="identity-library-frame" title="选择种族"></iframe></dialog>
  <dialog id="reference-library"><header><h2>人物资料库</h2><button type="button" id="close-reference-library">返回人物卡</button></header><iframe id="reference-library-frame" title="人物资料库"></iframe></dialog>
  <dialog id="spell-library" aria-label="法术资料库"><header><h2>法术资料库</h2><button type="button" id="close-spell-library">返回人物卡</button></header><iframe title="选择准备法术" id="spell-library-frame"></iframe></dialog>
  <dialog id="owned-spell-library" aria-label="从已知法术准备"><header><h2>从法术书／旅行书准备</h2><button type="button" id="close-owned-spells">返回人物卡</button></header><p>仅列已登记的法术。</p><div id="owned-spell-list"></div><button type="button" id="add-owned-spells">加入准备清单</button><p id="owned-spell-status" role="status"></p></dialog>
  <script>import '../../character/ref2/controller';</script>
</div>
