---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classes } from '../../data/public/classes';
import { races } from '../../data/public/races';
---
<BaseLayout title="快速车卡"><div class="section-heading"><h1>快速车卡</h1><span class="muted small">localStorage · JSON · 打印</span></div><p class="lede">这是桌面辅助工具，不替主持人裁决版本差异。最低属性、种族限制和多职业提示只做提示，不阻止强制填写。</p>
  <div class="character-layout">
    <form id="character-form" class="character-form">
      <h2>人物基础</h2><div class="field-grid"><label>姓名<input name="name" /></label><label>种族<select name="race"><option value="">请选择</option>{races.map((race) => <option value={race.id}>{race.nameZh}</option>)}</select></label><label>职业<select name="class"><option value="">请选择</option>{classes.map((entry) => <option value={entry.id}>{entry.nameZh}</option>)}</select></label><label>等级<input name="level" type="number" min="1" value="1" /></label><label>阵营<input name="alignment" /></label></div>
      <h2>属性</h2><div class="table-wrap"><table class="data-table ability-table"><thead><tr><th>属性</th><th>数值</th><th>常用派生值</th></tr></thead><tbody>{['STR','INT','WIS','DEX','CON','CHA'].map((ability) => <tr><th scope="row">{ability}</th><td><input name={ability} type="text" inputmode="numeric" /></td><td id={`derived-${ability}`}>—</td></tr>)}</tbody></table></div>
      <h2>操作</h2><div class="character-actions"><button type="button" id="roll-3d6">随机 3d6</button><button type="button" id="roll-4d6">随机 4d6 去最低</button><button type="button" id="save-character">保存到浏览器</button><button type="button" id="load-character">加载保存</button><button type="button" id="export-character">导出 JSON</button><label class="button" for="import-character">导入 JSON</label><input id="import-character" class="screen-only" type="file" accept="application/json" /><button type="button" id="print-character">打印 / 保存 PDF</button></div>
      <p id="character-status" class="small muted"></p>
    </form>
    <aside class="character-form"><h2>规则提示</h2><ul id="rule-hints"><li>选择种族与职业后显示提示。</li></ul><h2>常用派生值</h2><ul class="derived-list"><li><span>STR 命中 / 伤害</span><strong id="summary-str">—</strong></li><li><span>STR 负重</span><strong id="summary-weight">—</strong></li><li><span>DEX 反应 / 飞弹 / 防御</span><strong id="summary-dex">—</strong></li><li><span>CON HP / System Shock</span><strong id="summary-con">—</strong></li><li><span>CHA Henchmen / Loyalty</span><strong id="summary-cha">—</strong></li></ul><p class="muted small">Exceptional Strength 以 18/xx 文本保留；本 MVP 不代掷角色职业专属表。</p></aside>
  </div>
  <script define:vars={{ classes, races }}>
    const form = document.querySelector('#character-form'); const status = document.querySelector('#character-status'); const inputs = [...form.querySelectorAll('input, select')]; const abilities = ['STR', 'INT', 'WIS', 'DEX', 'CON', 'CHA'];
    const abilityNumber = (value) => { const match = String(value ?? '').match(/^18(?:\/(\d+))?$/); if (match) return 18 + Number(match[1] ?? 0) / 100; const n = Number(value); return Number.isFinite(n) ? n : 0; };
    const adjust = (score) => score >= 18 ? 1 : score <= 3 ? -3 : score <= 5 ? -2 : score <= 8 ? -1 : score <= 12 ? 0 : score <= 15 ? 1 : 2;
    const characterData = () => Object.fromEntries(inputs.map((input) => [input.name || input.id, input.value]));
    const update = () => { const data = characterData(); const str = abilityNumber(data.STR); const dex = abilityNumber(data.DEX); const con = abilityNumber(data.CON); const cha = abilityNumber(data.CHA); const strAdj = adjust(str); const dexAdj = adjust(dex); const conAdj = adjust(con); const chaAdj = adjust(cha); document.querySelector('#derived-STR').textContent = `${strAdj >= 0 ? '+' : ''}${strAdj} 命中 / 伤害`; document.querySelector('#derived-DEX').textContent = `${dexAdj >= 0 ? '+' : ''}${dexAdj} 反应 / 飞弹 / 防御`; document.querySelector('#derived-CON').textContent = `${conAdj >= 0 ? '+' : ''}${conAdj} HP（示例）`; document.querySelector('#derived-CHA').textContent = `${Math.max(1, 4 + chaAdj)} 名随从（示例）`; document.querySelector('#summary-str').textContent = `${strAdj >= 0 ? '+' : ''}${strAdj} / ${strAdj >= 0 ? '+' : ''}${strAdj}`; document.querySelector('#summary-weight').textContent = `${Math.max(0, 50 + str * 10)} lb.（示例）`; document.querySelector('#summary-dex').textContent = `${dexAdj >= 0 ? '+' : ''}${dexAdj} / ${dexAdj >= 0 ? '+' : ''}${dexAdj} / ${dexAdj >= 0 ? '+' : ''}${dexAdj}`; document.querySelector('#summary-con').textContent = `${conAdj >= 0 ? '+' : ''}${conAdj} / ${Math.min(99, 50 + con * 2)}%`; document.querySelector('#summary-cha').textContent = `${Math.max(1, 4 + chaAdj)} / ${chaAdj >= 0 ? '+' : ''}${chaAdj}`; const hints = []; const race = races.find((entry) => entry.id === data.race); const classEntry = classes.find((entry) => entry.id === data.class); if (race) hints.push(`${race.nameZh}：${race.restrictions}；等级限制：${race.levelLimits}。`); if (classEntry) hints.push(`${classEntry.nameZh}：主属性 ${classEntry.primeRequisite}；最低属性与多职业限制请对照来源。`); document.querySelector('#rule-hints').innerHTML = (hints.length ? hints : ['选择种族与职业后显示提示。']).map((hint) => `<li>${hint}</li>`).join(''); };
    const roll = (dropLowest) => { const scores = []; for (let i = 0; i < 6; i += 1) { const dice = Array.from({ length: dropLowest ? 4 : 3 }, () => Math.floor(Math.random() * 6) + 1).sort((a, b) => b - a); scores.push(dice.slice(0, 3).reduce((sum, value) => sum + value, 0)); } abilities.forEach((ability, index) => { form.elements[ability].value = scores[index]; }); update(); status.textContent = dropLowest ? '已生成 4d6 去最低。' : '已生成 3d6。'; };
    inputs.forEach((input) => input.addEventListener('input', update));
    document.querySelector('#roll-3d6').addEventListener('click', () => roll(false)); document.querySelector('#roll-4d6').addEventListener('click', () => roll(true));
    document.querySelector('#save-character').addEventListener('click', () => { localStorage.setItem('adnd1e-character', JSON.stringify(characterData())); status.textContent = '已保存到此浏览器。'; });
    document.querySelector('#load-character').addEventListener('click', () => { const saved = JSON.parse(localStorage.getItem('adnd1e-character') ?? 'null'); if (!saved) { status.textContent = '没有找到保存的人物。'; return; } Object.entries(saved).forEach(([key, value]) => { if (form.elements[key]) form.elements[key].value = value; }); update(); status.textContent = '已加载保存的人物。'; });
    document.querySelector('#export-character').addEventListener('click', () => { const blob = new Blob([JSON.stringify(characterData(), null, 2)], { type: 'application/json' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `${characterData().name || 'adnd1e-character'}.json`; link.click(); URL.revokeObjectURL(link.href); });
    document.querySelector('#import-character').addEventListener('change', async (event) => { const file = event.target.files[0]; if (!file) return; const imported = JSON.parse(await file.text()); Object.entries(imported).forEach(([key, value]) => { if (form.elements[key]) form.elements[key].value = value; }); update(); status.textContent = '已导入 JSON。'; });
    document.querySelector('#print-character').addEventListener('click', () => window.print()); update();
  </script>
</BaseLayout>
