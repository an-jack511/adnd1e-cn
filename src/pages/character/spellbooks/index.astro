---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import spellbooks from '../../../data/character-spellbooks.json';
import spells from '../../../data/public/spell-index.json';
import '../../../styles/ref2.css';
---
<BaseLayout title="人物法术书" description="法术书、已知法术与旅行副本。">
<main class="ref2-workspace spellbook-workspace">
  <header class="card-workspace-heading"><div><h1>法术书</h1><p>人物藏书与旅行副本</p></div><p><a href="/character/">返回人物卡</a> · <a href="/books/">图书馆</a></p></header>
  <nav class="ref2-tabs spellbook-controls"><label class="ref2-field"><span>人物</span><select id="character-choice"><option value="">当前人物</option></select></label><label class="ref2-field"><span>法术书目录</span><select id="spellbook-choice"><option value="">选择图书馆法术书</option>{spellbooks.map(book=><option value={book.id}>{book.code} · {book.title}</option>)}</select></label><a id="spellbook-pdf" href="/books/" target="_blank" rel="noreferrer">打开图书馆 PDF</a></nav>
  <p class="spellbook-help-link"><a href="/character/help/#spellbooks">法术书怎么用</a></p>
  <div class="spellbook-content">
    <section class="ref2-paper">
      <header class="spellbook-heading"><div><h2 id="spellbook-title">选择一本法术书</h2><p id="spellbook-meta">先选择人物，再选法术书目录。</p></div><a id="spellbook-cover-link" href="/books/">打开本册 PDF</a></header>
      <div class="spellbook-levels" id="spellbook-levels"></div>
    </section>
    <section class="ref2-paper adventure-spells-panel">
      <header class="spellbook-heading"><div><h2>冒险所得法术</h2><p>登记实际找到、学会并抄入人物法术书的法术。</p></div></header>
      <label class="adventure-spell-search"><span>搜索法术</span><input id="adventure-spell-search" type="search" placeholder="输入中文名或英文名"></label>
      <p id="adventure-spell-status" class="spellbook-status-note" role="status" aria-live="polite"></p>
      <div id="adventure-spell-results" class="spellbook-check-list"></div>
    </section>
    <section class="ref2-paper">
      <h2>旅行法术书</h2>
      <div id="travel-books"></div><button id="add-travel-book" type="button">＋ 添加旅行法术书</button>
    </section>
  </div>
  <p id="spellbook-status" class="card-status" role="status" aria-live="polite"></p>
</main>
<script>
  import catalog from '../../../data/character-spellbooks.json';
  import spellData from '../../../data/public/spell-index.json';
  import {cardSpellCapacity} from '../../../character/ref2/spell-capacity';
  type Book=typeof catalog[number]; type Spell=typeof spellData[number];
  type SpellbookState={books:any[];travel:any[];adventure:string[]};
  const books=catalog as Book[], spellList=spellData as Spell[];
  const $=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
  const choice=$<HTMLSelectElement>('spellbook-choice'),characterChoice=$<HTMLSelectElement>('character-choice');
  const classLists:Record<string,string[]>={cleric:['Cleric'],druid:['Druid'],'magic-user':['Magic-User'],illusionist:['Illusionist'],ranger:['Druid'],'paladin':['Cleric'],bard:['Druid'],'oa-shukenja':['Shukenja','Sohei'],'oa-wu-jen':['Wu Jen']};
  let card:Record<string,any>|null=null, selected:Book|undefined;
  const readCard=()=>{try{const value=JSON.parse(localStorage.getItem('adnd1e-character')||'null');return value&&typeof value.fields==='object'&&value.fields?value:null;}catch{return null;}};
  function savedCards(){try{return (JSON.parse(localStorage.getItem('adnd1e-characters')||'[]') as Record<string,any>[]).filter(row=>row&&typeof row.fields==='object'&&row.fields);}catch{return [];}}
  function selectCard(){const saved=savedCards(),id=characterChoice.value;card=id?saved.find(row=>String(row.fields?.character_id)===id)??null:readCard();if(!card&&saved.length===1)card=saved[0];if(!card){$('spellbook-status').textContent=id?'未找到该人物。':'未保存人物。先保存人物卡。';render();return;}$('spellbook-status').textContent='';render();}
  function records():SpellbookState{try{const data=JSON.parse(String(card?.fields?.spellbook_records||'{}'));return {books:Array.isArray(data.books)?data.books:[],travel:Array.isArray(data.travel)?data.travel:[],adventure:Array.isArray(data.adventure)?data.adventure:[]};}catch{return {books:[],travel:[],adventure:[]};}}
  function persist(data=records()){if(!card)return;card.fields.spellbook_records=JSON.stringify(data);localStorage.setItem('adnd1e-character',JSON.stringify(card));const all=savedCards(),id=String(card.fields?.character_id||'');if(id){const index=all.findIndex(row=>String(row.fields?.character_id)===id);if(index>=0){all[index]=card;localStorage.setItem('adnd1e-characters',JSON.stringify(all));}}$('spellbook-status').textContent='已保存。';}
  function classNames(){return classLists[String(card?.fields?.class||'')]??[];}
  function classCompatible(spell:Spell){const id=String(card?.fields?.class||'');return !id||!classLists[id]||spell.classes.some(name=>classLists[id].includes(name));}
  function bookSpellIds(data=records()){return [...new Set(data.books.flatMap((book:any)=>{const listed=books.find(entry=>entry.id===book.id)?.spells.map((spell:any)=>spell.id)||[];const older=Object.values(book.levels||{}).flatMap((row:any)=>Array.isArray(row.spellIds)?row.spellIds:[]);return [...listed,...older];}))];}
  function learnedSpellIds(data=records()){return [...new Set([...bookSpellIds(data),...data.adventure])];}
  function travelSpellIds(entry:any){const raw=Array.isArray(entry.spells)?entry.spells:String(entry.spells||'').split(/[，,、\s]+/);return raw.map((token:string)=>spellList.find(spell=>spell.id===token||spell.nameZh===token||spell.nameEn.toLowerCase()===token.toLowerCase())?.id).filter(Boolean) as string[];}
  function travelCapacityBands(){const id=String(card?.fields?.class||'');if(id==='magic-user')return [{name:'小法术',levels:[0],capacity:9},{name:'一至三环',levels:[1,2,3],capacity:6},{name:'四至六环',levels:[4,5,6],capacity:4},{name:'七至九环',levels:[7,8,9],capacity:2}];if(id==='illusionist')return [{name:'一至二环',levels:[1,2],capacity:6},{name:'三至四环',levels:[3,4],capacity:4},{name:'五至七环',levels:[5,6,7],capacity:2}];return [];}
  function spellOption(spell:Spell,checked:boolean,disabled:boolean,onChange?:(value:boolean)=>void){
    const item=document.createElement('div');item.className='spell-choice';const label=document.createElement('label'),name=document.createElement('span');name.textContent=`${spell.nameZh} · ${spell.nameEn}`;if(onChange){const input=document.createElement('input');input.type='checkbox';input.checked=checked;input.disabled=disabled;input.addEventListener('change',()=>onChange(input.checked));label.append(input,name);}else{label.className='spell-static-label';label.append(name);}
    const info=document.createElement('button');info.type='button';info.className='spell-info-button';info.textContent='详情';info.setAttribute('aria-label',`查看${spell.nameZh}详情`);info.setAttribute('aria-expanded','false');const popup=document.createElement('div');popup.className='spell-tooltip';popup.setAttribute('role','tooltip');popup.hidden=true;
    const title=document.createElement('strong');title.textContent=`${spell.nameZh} · ${spell.nameEn}`;const facts: [string,string][]=[['环级',spell.level===0?'小法术':`${spell.level}环`],['职业',spell.classes.join('、')],['学派',spell.school],['施法时间',spell.castingTime],['距离',spell.range],['持续时间',spell.duration],['作用范围',spell.areaOfEffect],['豁免',spell.savingThrow],['成分',spell.components.join('、')],['来源',spell.source.map(source=>`${source.book}${source.page?` 第 ${source.page} 页`:''}`).join('；')]];
    popup.append(title);for(const [key,value] of facts){if(!value)continue;const line=document.createElement('p');line.textContent=`${key}：${value}`;popup.append(line);}if(spell.reversible){const line=document.createElement('p');line.textContent='可逆法术';popup.append(line);}
    let pinned=false;const show=()=>{popup.hidden=false;info.setAttribute('aria-expanded','true');};const hide=()=>{if(!pinned){popup.hidden=true;info.setAttribute('aria-expanded','false');}};
    item.addEventListener('pointerenter',event=>{if(event.pointerType==='mouse')show();});item.addEventListener('pointerleave',hide);item.addEventListener('focusin',show);item.addEventListener('focusout',event=>{if(!item.contains(event.relatedTarget as Node|null))hide();});info.addEventListener('click',()=>{pinned=!pinned;if(pinned)show();else hide();});item.append(label,info,popup);return item;
  }
  function render(){const data=records();selected=books.find(book=>book.id===choice.value)||books.find(book=>book.id===data.books[0]?.id);if(selected)choice.value=selected.id;
    const levelHost=$<HTMLDivElement>('spellbook-levels');levelHost.replaceChildren();const capacity=card?.fields?cardSpellCapacity(card.fields):null;const classLabel=String(card?.fields?.class||'未选职业'),characterName=String(card?.fields?.name||'当前人物');
    if(selected){const info=selected.spells.map((entry:any)=>{const known=spellList.find(s=>s.id===entry.id);return known?{...known}:null;}).filter(Boolean) as Spell[],bookCapacities=(selected as any).standardBooks?.map((entry:any)=>`${entry.band} ${entry.used}/${entry.capacity}`).join(' · ');
      $('spellbook-title').textContent=`${selected.code} · ${selected.title}`;$('spellbook-meta').textContent=`${characterName} · ${classLabel} ${card?.fields?.level||''}级 · 固定目录 ${selected.spells.length} 项${bookCapacities?` · 标准书容量 ${bookCapacities}`:''}${capacity?.note?` · ${capacity.note}`:''}`;$('spellbook-pdf').setAttribute('href',selected.file);$('spellbook-cover-link').setAttribute('href',selected.file);$('spellbook-cover-link').textContent='打开本册 PDF';
      for(let level=1;level<=9;level++){const listed=info.filter(spell=>spell.level===level);if(!listed.length&&!Number(selected.counts[String(level)]||0))continue;const row=document.createElement('section');row.className='spellbook-level';const title=document.createElement('h3');title.textContent=`${level} 环`;
        const adventureCount=data.adventure.filter(id=>spellList.find(spell=>spell.id===id)?.level===level).length,slot=capacity?.daily?.[level],castable=listed.filter(spell=>classCompatible(spell)).length;const meta=document.createElement('p');meta.className='spellbook-level-meta';meta.textContent=`书内 ${Number(selected.counts[String(level)]??listed.length)} 种 · 本职业法术 ${castable} 种 · 冒险所得 ${adventureCount} 种 · 每日可备 ${slot??'未计算'} 份`;
        const list=document.createElement('div');list.className='spellbook-check-list';if(!listed.length){const empty=document.createElement('p');empty.textContent='本环法术暂无索引。';list.append(empty);}for(const spell of listed){const compatible=classCompatible(spell),canPrepare=!!slot&&slot>0,option=spellOption(spell,false,false);const note=document.createElement('small');note.className='spell-incompatible';note.textContent=!compatible?`不属于${classLabel}法术表`:canPrepare?'可从本册准备':'当前等级尚无本环法术位';option.append(note);list.append(option);}
        row.append(title,meta,list);levelHost.append(row);
      }
      if(!classNames().length&&card?.fields?.class){const note=document.createElement('p');note.className='spellbook-help';note.textContent='此职业尚未映射到法术库职业名；目录显示全部法术，请按职业资料核对。';levelHost.prepend(note);}
    }else{$('spellbook-title').textContent='选择一本法术书';$('spellbook-meta').textContent='从图书馆收录的法术书中选择目录。';}
    renderAdventure(data);renderTravel(data);
  }
  function renderAdventure(data=records()){const search=$<HTMLInputElement>('adventure-spell-search'),host=$<HTMLDivElement>('adventure-spell-results'),query=search.value.trim().toLocaleLowerCase(),known=new Set(data.adventure),inBooks=new Set(bookSpellIds(data));host.replaceChildren();const candidates=spellList.filter(spell=>classCompatible(spell)&&(known.has(spell.id)||(!inBooks.has(spell.id)&&query.length>0&&`${spell.nameZh} ${spell.nameEn}`.toLocaleLowerCase().includes(query)))).sort((a,b)=>a.level-b.level||a.nameZh.localeCompare(b.nameZh,'zh-CN'));$('adventure-spell-status').textContent=known.size?`冒险所得已登记 ${known.size} 种。${query?'搜索结果可勾选加入或取消。':'输入法术名查看其他法术。'}`:'输入法术名，勾选冒险中已学会的法术。';if(!candidates.length){const empty=document.createElement('p');empty.textContent=query?'没有匹配的本职业法术。':'尚未登记冒险所得法术。';host.append(empty);return;}
    let level=-1;for(const spell of candidates){if(spell.level!==level){level=spell.level;const heading=document.createElement('h3');heading.className='spell-group-heading';heading.textContent=level===0?'小法术':`${level} 环`;host.append(heading);}host.append(spellOption(spell,known.has(spell.id),false,value=>{const current=records(),ids=new Set(current.adventure);value?ids.add(spell.id):ids.delete(spell.id);current.adventure=[...ids];persist(current);render();}));}}
  function renderTravel(data=records()){const host=$<HTMLDivElement>('travel-books');host.replaceChildren();const learned=new Set(learnedSpellIds(data));for(const entry of data.travel){const row=document.createElement('section');row.className='travel-book-row';
    for(const [key,label] of [['name','书名'],['capacity','备注']] as const){const wrap=document.createElement('label');wrap.textContent=label;const input=document.createElement('input');input.value=entry[key]||'';if(key==='capacity')input.placeholder='可选';input.addEventListener('input',()=>{entry[key]=input.value;persist(data);});wrap.append(input);row.append(wrap);}
    const known=new Set(travelSpellIds(entry)),legacy=[...known].filter(id=>!learned.has(id)),spellWrap=document.createElement('div');spellWrap.className='travel-spell-picker';const search=document.createElement('input');search.type='search';search.placeholder='搜已学法术';search.setAttribute('aria-label',`${entry.name||'旅行书'}搜索已学法术`);const list=document.createElement('div');list.className='travel-spell-list';const summary=document.createElement('small');
    const paintOptions=()=>{const query=search.value.trim().toLocaleLowerCase(),bands=travelCapacityBands();list.replaceChildren();const matches=spellList.filter(spell=>learned.has(spell.id)&&(!query||`${spell.nameZh} ${spell.nameEn}`.toLocaleLowerCase().includes(query))).sort((a,b)=>a.level-b.level||a.nameZh.localeCompare(b.nameZh,'zh-CN'));for(const spell of matches){const band=bands.find(item=>item.levels.includes(spell.level)),used=band?[...known].filter(id=>{const knownSpell=spellList.find(candidate=>candidate.id===id);return knownSpell&&band.levels.includes(knownSpell.level);}).length:0,full=!!band&&used>=band.capacity&&!known.has(spell.id),option=spellOption(spell,known.has(spell.id),full,value=>{value?known.add(spell.id):known.delete(spell.id);entry.spells=[...known];persist(data);paintOptions();});if(full)option.title=`${band!.name}容量已满（${band!.capacity}项）`;list.append(option);}const usedCount=[...known].filter(id=>learned.has(id)).length;summary.textContent=bands.length?`已抄 ${usedCount} 种 · ${bands.map(band=>`${band.name} ${[...known].filter(id=>{const spell=spellList.find(candidate=>candidate.id===id);return spell&&band.levels.includes(spell.level);}).length}/${band.capacity}`).join(' · ')}`:`已抄 ${usedCount} 种 · 此职业未设自动容量表。`;
      if(!matches.length){const empty=document.createElement('p');empty.textContent=query?'没有匹配的已学法术。':learned.size?'搜索并勾选要带走的法术。':'先登记人物已学法术。';list.append(empty);}};
    search.addEventListener('input',paintOptions);paintOptions();spellWrap.append(search,list,summary);
    if(legacy.length){const migration=document.createElement('p');migration.className='spellbook-migration';migration.textContent=`旧旅行书有 ${legacy.length} 种法术尚未登记为已学。`;const register=document.createElement('button');register.type='button';register.textContent='登记为冒险所得';register.addEventListener('click',()=>{const current=records();current.adventure=[...new Set([...current.adventure,...legacy])];persist(current);render();});migration.append(' ',register);spellWrap.append(migration);}
    row.append(spellWrap);const remove=document.createElement('button');remove.type='button';remove.textContent='移除旅行书';remove.addEventListener('click',()=>{data.travel=data.travel.filter((book:any)=>book!==entry);persist(data);renderTravel(data);});row.append(remove);host.append(row);}}
  $('adventure-spell-search').addEventListener('input',()=>renderAdventure());
  choice.addEventListener('change',()=>{selected=books.find(book=>book.id===choice.value);if(card){const data=records();if(selected&&!data.books.some((b:any)=>b.id===selected!.id))data.books.push({id:selected.id,levels:{}});card.fields.spellbook_records=JSON.stringify(data);render();persist();}else{render();$('spellbook-status').textContent=selected?'未保存人物。先保存人物卡。':'';}});
  characterChoice.addEventListener('change',selectCard);
  $('add-travel-book').addEventListener('click',()=>{if(!card){selectCard();if(!card)return;}const data=records();data.travel.push({name:'',capacity:'',spells:[]});card.fields.spellbook_records=JSON.stringify(data);render();persist();});
  const stored=savedCards();for(const entry of stored){if(entry.fields?.character_id)characterChoice.add(new Option(String(entry.fields.name||'未命名人物'),String(entry.fields.character_id)));}selectCard();
</script>
</BaseLayout>
