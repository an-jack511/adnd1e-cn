---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classes } from '../../data/public/classes';
---
<BaseLayout title="职业"><h1>职业</h1><div class="table-wrap"><table class="data-table compact"><thead><tr><th>职业</th><th>英文</th><th>最低属性</th><th>生命骰</th><th>阵营</th><th>施法</th></tr></thead><tbody>{classes.map((entry) => <tr><td><a href={`/classes/${entry.id}/`}>{entry.nameZh}</a></td><td>{entry.nameEn}</td><td>{Object.entries(entry.minimumAbilities).map(([ability, score]) => `${ability} ${score}`).join('、')}</td><td>{entry.hitDie}</td><td>{entry.alignment}</td><td>{entry.spellcasting}</td></tr>)}</tbody></table></div></BaseLayout>
