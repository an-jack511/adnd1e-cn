---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { rules } from '../../data/public/rules';
import { playPages } from '../../data/public/play';
const guide = playPages.find((page) => page.slug === 'combat')!;
const entries = rules.filter((rule) => rule.category === 'combat');
---
<BaseLayout title="战斗规则">
  <h1>战斗规则</h1>
  <p>{guide.intro}</p>
  <h2>一轮中的次序</h2>
  <ol>{guide.sequence.map((step) => <li>{step}</li>)}</ol>
  <p>速查：{guide.sections.map((section, index) => <span><a href={`/play/combat/#${section.id}`}>{section.title}</a>{index < guide.sections.length - 1 ? ' · ' : ''}</span>)}</p>
  <h2>常用规则</h2>
  <table class="directory-groups"><tbody>{entries.map((rule) => <tr><th scope="row"><a href={`/combat/${rule.id}/`}>{rule.title}</a></th><td>{rule.summary}</td></tr>)}</tbody></table>
  <p><a href="/play/combat/">阅读完整战斗流程与出处</a> · <a href="/play/encounter/">从遭遇开始</a> · <a href="/equipment/">查武器</a></p>
</BaseLayout>
