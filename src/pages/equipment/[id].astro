---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import { items } from '../../data/public/items';
export function getStaticPaths() { return items.map((item) => ({ params: { id: item.id }, props: { item } })); }
const { item } = Astro.props;
---
<BaseLayout title={`${item.nameZh} ${item.nameEn}`}><article>
  <header class="entry-header"><h1>{item.nameZh}</h1><div class="english">{item.nameEn} · {item.category}</div></header>
  <div class="entry-meta"><div><dt>价格</dt><dd>{item.price}</dd></div><div><dt>负重</dt><dd>{item.weight}</dd></div><div><dt>伤害 S/M</dt><dd>{item.damageSmallMedium ?? '—'}</dd></div><div><dt>伤害 L</dt><dd>{item.damageLarge ?? '—'}</dd></div><div><dt>长度</dt><dd>{item.length ?? '—'}</dd></div><div><dt>所需空间</dt><dd>{item.spaceRequired ?? '—'}</dd></div><div><dt>速度因子</dt><dd>{item.speedFactor ?? '—'}</dd></div><div><dt>AC 调整</dt><dd>{item.acAdjustment ?? '—'}</dd></div></div>
  <p>{item.description}</p><SourceList sources={item.source} /><p><a href={item.category === '魔法物品' ? '/equipment/magic-items/' : '/equipment/'}>← 返回{item.category === '魔法物品' ? '魔法物品' : '装备与物品'}</a></p>
  {item.weaponCombat?.handHeld && <section class="weapon-combat"><h2>手持武器数据</h2><p>长度 {item.weaponCombat.handHeld.length}；所需空间 {item.weaponCombat.handHeld.spaceRequired}；速度因数 {item.weaponCombat.handHeld.speedFactor}。</p><table><thead><tr><th>目标 AC</th>{item.weaponCombat.handHeld.armorClassAdjustments.map((_, index) => <th>{index}</th>)}</tr></thead><tbody><tr><th>命中调整</th>{item.weaponCombat.handHeld.armorClassAdjustments.map((value) => <td>{value}</td>)}</tr></tbody></table></section>}
  {item.weaponCombat?.missile && <section class="weapon-combat"><h2>投掷／射击数据</h2><p>射速 {item.weaponCombat.missile.fireRate}；短程 {item.weaponCombat.missile.range.short}，中程 {item.weaponCombat.missile.range.medium}，远程 {item.weaponCombat.missile.range.long}。</p><table><thead><tr><th>目标 AC</th>{item.weaponCombat.missile.armorClassAdjustments.map((_, index) => <th>{index}</th>)}</tr></thead><tbody><tr><th>命中调整</th>{item.weaponCombat.missile.armorClassAdjustments.map((value) => <td>{value}</td>)}</tr></tbody></table></section>}
</article></BaseLayout>
