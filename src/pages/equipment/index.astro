---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryTable from '../../components/EntryTable.astro';
import { items } from '../../data/public/items';
const categories = [...new Set(items.map((item) => item.category))].sort();
const rows = items.map((item) => [item.nameZh, item.nameEn, item.category, item.price, item.weight, item.damageSmallMedium ?? '—', item.damageLarge ?? '—', item.speedFactor ?? '—', item.acAdjustment ?? '—']);
const links = items.map((item) => [`/equipment/${item.id}`, undefined, undefined, undefined, undefined, undefined, undefined, undefined, undefined]);
---
<BaseLayout title="装备与物品" description="AD&D 1E 中文装备与魔法物品索引。">
  <div class="section-heading"><h1>装备与物品</h1><a href="/search?type=item">在全站搜索装备</a></div>
  <p class="lede">普通装备与魔法物品共用一个可扩展结构；武器保留 S/M、L、长度、space required、speed factor、AC adjustment 等 1E 属性。</p>
  <div class="controls"><div class="filter-grid">
    <label>名称 <input id="item-name" type="search" /></label>
    <label>类别 <select id="item-category"><option value="">全部类别</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
    <label>价格上限（gp） <input id="item-price" type="number" min="0" /></label>
    <label>速度因子 <input id="item-speed" type="search" /></label>
  </div></div>
  <p id="item-count" class="results-count">显示 {items.length} 件物品</p>
  <div id="item-results"><EntryTable headers={['中文名', '英文名', '类别', '价格', '重量', '伤害 S/M', '伤害 L', '速度因子', 'AC 调整']} rows={rows} links={links} /></div>
  <script define:vars={{ items }}>
    const name = document.querySelector('#item-name'); const category = document.querySelector('#item-category'); const price = document.querySelector('#item-price'); const speed = document.querySelector('#item-speed'); const count = document.querySelector('#item-count'); const results = document.querySelector('#item-results');
    const numericPrice = (value) => Number.parseFloat(value.replace(/[^0-9.]/g, '')) || 0;
    const render = () => { const query = name.value.trim().toLowerCase(); const filtered = items.filter((item) => (!query || `${item.nameZh} ${item.nameEn} ${item.description} ${item.tags.join(' ')}`.toLowerCase().includes(query)) && (!category.value || item.category === category.value) && (!price.value || numericPrice(item.price) <= Number(price.value)) && (!speed.value || item.speedFactor === speed.value)); count.textContent = `显示 ${filtered.length} 件物品`; results.innerHTML = `<div class="table-wrap"><table class="data-table compact"><thead><tr><th>中文名</th><th>英文名</th><th>类别</th><th>价格</th><th>重量</th><th>伤害 S/M</th><th>伤害 L</th><th>速度因子</th><th>AC 调整</th></tr></thead><tbody>${filtered.map((item) => `<tr><td><a href="/equipment/${item.id}">${item.nameZh}</a></td><td>${item.nameEn}</td><td>${item.category}</td><td>${item.price}</td><td>${item.weight}</td><td>${item.damageSmallMedium ?? '—'}</td><td>${item.damageLarge ?? '—'}</td><td>${item.speedFactor ?? '—'}</td><td>${item.acAdjustment ?? '—'}</td></tr>`).join('')}</tbody></table></div>`; };
    [name, category, price, speed].forEach((input) => input.addEventListener('input', render));
  </script>
</BaseLayout>
