---
import BaseLayout from '../layouts/BaseLayout.astro';
import { books } from '../data/public/books';
import { spells } from '../data/public/spells';
import { monsters } from '../data/public/monsters';
import { items } from '../data/public/items';
import published from '../data/published/books.json';
---
<BaseLayout>
  <p class="home-intro">本站整理 AD&amp;D 1st Edition 中文规则资料。条目按跑团时的查询用途编排，并保留原书来源。</p>
  <form class="home-search" action="/search" method="get">
    <label for="home-search">站内检索：</label>
    <input id="home-search" name="q" type="search" size="34" />
    <button type="submit">搜索</button>
  </form>

  <h2>规则资料</h2>
  <table class="home-directory"><tbody>
    <tr><th scope="row"><a href="/adventure/">冒险</a></th><td><a href="/adventure/movement-time-distance/">时间与移动</a> · <a href="/adventure/light/">光照</a> · <a href="/adventure/traps/">陷阱</a> · <a href="/adventure/encounters/">遭遇</a> · <a href="/adventure/encumbrance/">负重</a></td></tr>
    <tr><th scope="row"><a href="/combat/">战斗</a></th><td><a href="/combat/combat-sequence/">战斗流程</a> · <a href="/combat/surprise/">突袭</a> · <a href="/combat/initiative/">先攻</a> · <a href="/combat/armor-class/">AC</a> · <a href="/combat/damage/">伤害</a></td></tr>
    <tr><th scope="row">人物</th><td><a href="/races/">种族</a> · <a href="/classes/">职业</a> · <a href="/character/">快速车卡</a> · <a href="/rules/ability-scores/">属性与派生值</a></td></tr>
    <tr><th scope="row">资料库</th><td><a href="/spells/">法术表</a>（{spells.length}） · <a href="/equipment/">装备与物品</a>（{items.length}） · <a href="/monsters/">怪物合集</a>（{monsters.length}） · <a href="/tables/">随机表</a></td></tr>
    <tr><th scope="row">其他规则</th><td><a href="/psionics/">灵能与其他规则</a> · <a href="/rules/strongholds/">据点</a> · <a href="/rules/">全部规则索引</a></td></tr>
  </tbody></table>

  <h2>规则书</h2>
  <p class="book-shortcuts">{books.map((book, index) => <span>{index > 0 && ' | '}<a href={`/books/${book.id}/`}>{book.short}</a>{published.some((topic) => topic.book === book.id) && `（${published.filter((topic) => topic.book === book.id).length} 篇）`}</span>)}</p>

  <h2>最近整理</h2>
  <table class="updates-table"><tbody>
    <tr><td>2026-10-02</td><td>接入 PHB、DMG 与 MM 已有中文工作译稿，并更新快速车卡。</td></tr>
    <tr><td>2026-10-01</td><td>建立法术、怪物、装备索引及来源链接。</td></tr>
  </tbody></table>
  <p class="small">法术、怪物、装备的结构化数据仍在扩充；书内译文为工作稿，尚未经逐句终校。</p>
</BaseLayout>
