---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bookshelf from '../../components/Bookshelf.astro';
import { manuals, manualCategories } from '../../data/manuals';
const shelfBooks = manuals.map(book => ({
  id: book.id, title: book.title, cover: book.cover, href: `/manuals/${book.id}/`,
  code: `${book.pages} 页 · PDF`, categories: [book.category],
}));
---
<BaseLayout title="自编手册">
  <header class="shelf-page-heading"><h1>自编手册</h1><nav class="shelf-page-links" aria-label="图书馆导航"><a href="/books/">规则书库</a></nav></header>
  <Bookshelf books={shelfBooks} categories={manualCategories} label="自编手册" />
</BaseLayout>
