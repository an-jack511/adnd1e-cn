---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import { monsters } from '../../data/public/monsters';
export function getStaticPaths() { return monsters.map((monster) => ({ params: { id: monster.id }, props: { monster } })); }
const { monster } = Astro.props;
---
<BaseLayout title={`${monster.nameZh} ${monster.nameEn}`} description={`${monster.nameZh}（${monster.nameEn}）AD&D 1E 怪物条目。`}>
  <article>
    <header class="entry-header"><h1>{monster.nameZh}</h1><div class="english">{monster.nameEn}</div></header>
    <table class="statblock"><tbody>
      <tr><th scope="row">频率 Frequency</th><td>{monster.frequency}</td></tr>
      <tr><th scope="row">出现数量 No. Appearing</th><td>{monster.numberAppearing}</td></tr>
      <tr><th scope="row">护甲等级 AC</th><td>{monster.armorClass}</td></tr>
      <tr><th scope="row">移动 Movement</th><td>{monster.movement}</td></tr>
      <tr><th scope="row">生命骰 HD</th><td>{monster.hitDice}</td></tr>
      <tr><th scope="row">巢穴 % in Lair</th><td>{monster.inLair}</td></tr>
      <tr><th scope="row">宝藏 Treasure</th><td>{monster.treasureType}</td></tr>
      <tr><th scope="row">攻击次数</th><td>{monster.attacks}</td></tr>
      <tr><th scope="row">伤害 Damage</th><td>{monster.damage}</td></tr>
      <tr><th scope="row">特殊攻击</th><td>{monster.specialAttacks}</td></tr>
      <tr><th scope="row">特殊防御</th><td>{monster.specialDefenses}</td></tr>
      <tr><th scope="row">魔法抗性</th><td>{monster.magicResistance}</td></tr>
      <tr><th scope="row">智力 Intelligence</th><td>{monster.intelligence}</td></tr>
      <tr><th scope="row">阵营 Alignment</th><td>{monster.alignment}</td></tr>
      <tr><th scope="row">体型 Size</th><td>{monster.size}</td></tr>
      <tr><th scope="row">灵能 Psionics</th><td>{monster.psionics}</td></tr>
      <tr><th scope="row">环境 Environment</th><td>{monster.environment}</td></tr>
    </tbody></table>
    <p>{monster.description}</p>
    {monster.illustration && <p><a href={`/illustrations/monsters/${monster.id}`}>插图：查看怪物插图</a></p>}
    <SourceList sources={monster.source} />
    <p><a href="/monsters">← 返回怪物合集</a></p>
  </article>
</BaseLayout>
