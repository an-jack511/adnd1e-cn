---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryTable from '../../components/EntryTable.astro';
import FilterChoices from '../../components/FilterChoices.astro';
import { monsters } from '../../data/public/monsters';
import { monsterSize, monsterSizeLabel, monsterSizeOptions } from '../../utils/monster-size';
const sources = [...new Set(monsters.flatMap((monster) => monster.source.map((source) => source.book)))].sort();
const records = monsters.map(monster=>({search:`${monster.nameZh} ${monster.nameEn} ${monster.description}`.toLowerCase(),hd:monster.hitDice.toLowerCase(),ac:monster.armorClass,alignment:monster.alignment.toLowerCase(),environment:monster.environment.toLowerCase(),facets:{source:monster.source.map(source=>source.book),size:[monsterSize(monster.size)]}}));
const rows = monsters.map((monster) => [monster.nameZh, monster.nameEn, monster.source.map((source) => source.book).join('、'), monster.hitDice, monster.armorClassText ?? (monster.armorClass === null ? '未知' : String(monster.armorClass)), monster.alignment, monsterSizeLabel(monster.size), monster.environment, monster.movement, monster.magicResistance, monster.psionics]);
const links = monsters.map((monster) => [`/monsters/${monster.id}`, undefined, undefined, undefined, undefined, undefined, undefined, undefined, undefined, undefined, undefined]);
---
<BaseLayout title="怪物合集" description="AD&D 1E 中文怪物索引与筛选。">
  <div class="section-heading"><h1>怪物合集</h1><a href="/search?type=monster">在全站搜索怪物</a></div>
  <p class="lede">按名称、HD、AC、阵营、环境及来源查询。插图另页查看。</p>
  <div class="controls"><div class="filter-grid">
    <label>名称 <input id="monster-name" type="search" placeholder="中文或英文" /></label>
    <label>HD <input id="monster-hd" type="search" placeholder="例如 5+2" /></label>
    <label>AC ≤ <input id="monster-ac" type="number" /></label>
    <label>阵营 <input id="monster-alignment" type="search" /></label>
    <label>环境 <input id="monster-environment" type="search" /></label>
  </div><FilterChoices name="size" label="体型" options={[...monsterSizeOptions]} /><FilterChoices name="source" label="来源" options={sources.map(value=>({value,label:value}))} /></div>
  <p id="monster-count" class="results-count">显示 {monsters.length} 条怪物</p>
  <div id="monster-results"><EntryTable headers={['中文名', '英文名', '来源', 'HD', 'AC', '阵营', '体型', '环境', '移动', '魔抗', '灵能']} rows={rows} links={links} records={records} /></div>
  <script>
    import {tableFilter} from '../../utils/table-filter';
    tableFilter<{search:string;hd:string;ac:number|null;alignment:string;environment:string}>('monster',['name','hd','ac','alignment','environment'],['size','source'],(record,values)=>record.search.includes(values.name) && record.hd.includes(values.hd) && (!values.ac || (record.ac!==null && record.ac<=Number(values.ac))) && record.alignment.includes(values.alignment) && record.environment.includes(values.environment));
  </script>
</BaseLayout>
