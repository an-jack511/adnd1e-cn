---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionChecklist from '../../components/SessionChecklist.astro';
import {playPages} from '../../data/public/play';
import {quickLinks,quickChecks} from '../../data/public/combat-guide';
import {attackMatrices,attackBands,opponentArmorClasses,savingBands,savingMatrices,saveLabels,type MatrixFamily} from '../../character/rules/core-combat-matrices';
import '../../styles/table-reference.css';
const families:{id:MatrixFamily,label:string,classes:string}[]=[
  {id:'fighter',label:'战士系',classes:'战士、圣武士、巡林客'},
  {id:'cleric',label:'牧师系',classes:'牧师、德鲁伊'},
  {id:'arcane',label:'奥术系',classes:'魔法师、幻术师'},
  {id:'thief',label:'盗贼系',classes:'盗贼、刺客'},
];
const bandLabel=([low,high]:readonly[number,number|null])=>high===null?`${low}+`:low===high?`${low}`:`${low}–${high}`;
---
<BaseLayout title="游戏中 · 桌边速查" description="AD&D 1E 跑团速查：检查单、核心概念、角色攻击矩阵、豁免及常用规则入口。">
<h1>游戏中 · 桌边速查</h1>
<p class="lede">跑团时从这里查数值、查条目、检查漏项。战斗的完整程序与行动先后说明见<a href="/play/combat/">战斗页</a>。</p>
<nav class="reference-nav" aria-label="桌边速查目录"><a href="#checklist">快速检查</a><a href="#concepts">重要概念</a><a href="#attack-matrices">攻击矩阵</a><a href="#saving-throws">豁免表</a><a href="#common">常用条目</a><a href="#guides">场景流程</a></nav>
<section id="checklist" class="reference-section"><h2>先检查这几项</h2><SessionChecklist title="开团与场景切换" items={quickChecks} /></section>
<section id="concepts" class="reference-section"><h2>重要概念速查</h2><table><thead><tr><th>概念</th><th>桌边记法</th><th>查阅</th></tr></thead><tbody>
<tr><th scope="row">回合／轮／段</th><td>探索回合 10 分钟；战斗轮 1 分钟；一轮 10 段，每段 6 秒。</td><td><a href="/books/phb/movement-time-distance/">PHB 移动与时间</a></td></tr>
<tr><th scope="row">距离的“寸”</th><td>室内通常 10 尺／寸，户外距离通常 10 码／寸；法术效果范围等例外须查条目。</td><td><a href="/books/phb/movement-time-distance/">PHB 距离</a></td></tr>
<tr><th scope="row">突袭／先攻</th><td>突袭在遭遇初始处理；阵营先攻每轮重掷，通常高者先。</td><td><a href="/play/combat/#surprise">突袭</a> · <a href="/play/combat/#initiative">先攻</a></td></tr>
<tr><th scope="row">最终 AC／护甲类型</th><td>最终 AC 越低越难命中；武器对护甲调整的类型不能直接用最终 AC 替代。</td><td><a href="/play/combat/#armor-class">护甲判定</a></td></tr>
<tr><th scope="row">攻击套路／攻击次数</th><td>爪／爪／咬通常是一套；重复整套与一套内多种攻击分开。</td><td><a href="/play/combat/#multiple-attacks">多轮攻击</a></td></tr>
<tr><th scope="row">SF／武器长度</th><td>SF 用于特定平手与施法对抗；冲锋接战先比较长度／触及。</td><td><a href="/play/combat/#weapon-speed">速度因子</a></td></tr>
<tr><th scope="row">S/M／L 伤害</th><td>按目标体型选武器伤害栏；S/M 为小型／中型，L 为大型。</td><td><a href="/equipment/">武器规格</a></td></tr>
<tr><th scope="row">命中／豁免</th><td>普通武器攻击查命中矩阵；法术、吐息、毒等依具体效果选择豁免类别。</td><td><a href="#attack-matrices">攻击</a> · <a href="#saving-throws">豁免</a></td></tr>
</tbody></table><p class="source-list">PHB 第 37–39、61、102–103 页；DMG 第 61–67、74、79 页。行动时序按<a href="/play/combat/#sources">战斗页注明的 A.D.D.I.C.T. 口径</a>展开。</p></section>
<section id="attack-matrices" class="reference-section"><h2>角色攻击矩阵</h2><p>展开对应职业系，以目标 AC 行与人物等级列交叉查 d20 目标值，再计入适用修正。保留原表连续的 20，不能把整表简单换成 THAC0 减 AC。表中数值不自动判定命中。</p>
{families.map(f=><details id={`attack-${f.id}`}><summary>{f.label} · {f.classes}</summary><div class="table-wrap" tabindex="0" role="region" aria-label={`${f.label}攻击矩阵`}><table class="numeric"><caption>{f.label}攻击矩阵 · 列为等级，格值为目标数</caption><thead><tr><th scope="col">目标 AC</th>{attackBands[f.id].map(band=><th scope="col">{bandLabel(band)} 级</th>)}</tr></thead><tbody>{opponentArmorClasses.map((ac,i)=><tr><th scope="row">{ac}</th>{attackMatrices[f.id][i].map(value=><td>{value}</td>)}</tr>)}</tbody></table></div><p class="small">来源：DMG 印刷第 74 页，矩阵 I.A–I.D.1；基础值不含属性、武器对护甲、熟练、射程、魔法与情境调整。</p></details>)}
<p>圣武士、巡林客等按相应职业说明使用战士表；武僧及扩展职业须查各自规则。吟游诗人攻击依实际战士履历，多职业／双职须核对对应规则，不能只按当前显示的一个等级套表。战士逐级进步的 DM 可选条款未在此启用。</p>
<p><a href="/read/dmg/64ff4d2e57bc8c49/#read-49734749281bd166">DMG 原文：角色／怪物攻击矩阵与脚注</a> · <a href="/reference/?q=攻击&kind=表格">检索其他攻击表</a></p></section>
<section id="saving-throws" class="reference-section"><h2>角色五类豁免</h2><p>按职业与等级取基础目标，d20 加适用调整后须达到目标。自然 1 总是失败。具体法术或攻击指定的豁免类别优先核对原表脚注。</p>
{families.map(f=><details id={`save-${f.id}`}><summary>{f.label} · 豁免目标</summary><div class="table-wrap" tabindex="0" role="region" aria-label={`${f.label}豁免表`}><table class="numeric"><caption>{f.label} · 基础豁免目标</caption><thead><tr><th scope="col">等级</th>{saveLabels.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{savingMatrices[f.id].map((row,i)=><tr><th scope="row">{bandLabel(savingBands[f.id][i])}</th>{row.map(value=><td>{value}</td>)}</tr>)}</tbody></table></div></details>)}
<p class="source-list">来源：<a href="/read/dmg/b420a83e5252f057/#read-b420a83e5252f057-table-1">DMG 印刷第 79 页，角色豁免表及脚注</a>。种族、属性、物品与职业特殊加值另计；多职、双职及吟游诗人按实际履历择适用表。变形魔杖等效果的归类须查脚注。</p></section>
<section id="common" class="reference-section"><h2>常用条目清单</h2><table class="home-directory"><tbody>{quickLinks.map(group=><tr><th scope="row">{group.title}</th><td>{group.links.map(([label,href],i)=><>{i>0&&' · '}<a href={href}>{label}</a></>)}</td></tr>)}</tbody></table><p><a href="/reference/">查全部原书表格</a> · <a href="/tables/">随机表</a> · <a href="/books/">规则书目录</a></p></section>
<section id="guides" class="reference-section"><h2>需要完整流程时</h2><table class="home-directory play-directory"><tbody>{playPages.map(page=><tr><th scope="row"><a href={`/play/${page.slug}/`}>{page.title}</a></th><td>{page.intro}</td></tr>)}</tbody></table></section>
</BaseLayout>
