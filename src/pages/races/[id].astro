---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import { races } from '../../data/public/races';
export function getStaticPaths() { return races.map((entry) => ({ params: { id: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
---
<BaseLayout title={`${entry.nameZh} ${entry.nameEn}`}><article><header class="entry-header"><h1>{entry.nameZh}</h1><div class="english">{entry.nameEn}</div></header><div class="entry-meta"><div><dt>属性调整</dt><dd>{entry.modifiers}</dd></div><div><dt>职业限制</dt><dd>{entry.restrictions}</dd></div><div><dt>等级限制</dt><dd>{entry.levelLimits}</dd></div><div><dt>移动</dt><dd>{entry.movement}</dd></div><div><dt>语言</dt><dd>{entry.languages}</dd></div></div><h2>特殊能力</h2><ul>{entry.abilities.map((ability) => <li>{ability}</li>)}</ul><SourceList sources={entry.source} /><p><a href="/races">← 返回种族</a></p></article></BaseLayout>
