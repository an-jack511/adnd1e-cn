---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { races } from '../../data/public/races';
import { classes } from '../../data/public/classes';
---
<BaseLayout title="种族"><h1>种族</h1><div class="table-wrap"><table class="data-table compact"><thead><tr><th>种族</th><th>英文</th><th>属性调整</th><th>移动</th><th>可选职业</th></tr></thead><tbody>{races.map((entry) => <tr><td><a href={`/races/${entry.id}/`}>{entry.nameZh}</a></td><td>{entry.nameEn}</td><td>{entry.modifiers}</td><td>{entry.movement}</td><td>{entry.eligibleClasses.map(({ id }) => classes.find((item) => item.id === id)?.nameZh ?? id).join('、')}</td></tr>)}</tbody></table></div></BaseLayout>
