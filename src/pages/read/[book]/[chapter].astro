---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {reading,readingRoutes} from '../../../utils/book-reading';
import directory from '../../../data/public/book-directory.json';
import {readingContent,readerTitle} from '../../../utils/book-reading-content';
export function getStaticPaths() {
 return readingRoutes();
}
const {book,chapter,start}=Astro.props;
const info=directory.find(entry=>entry.id===book)!;
let content=readingContent(book,chapter);
if(book==='phb')content=readerTitle(chapter.title)+content;
content=content.replace(/\b(href|src)="([^"]+)"/gi,(_match,key,value)=>value.startsWith('#')||value.startsWith('/')||/^[a-z]+:/i.test(value) ? `${key}="${value}"` : `${key}="${new URL(value,`https://local.invalid/archive/${book}/`).pathname}${new URL(value,`https://local.invalid/archive/${book}/`).hash}"`);
const groups=reading[book as keyof typeof reading];
const siblings=groups.flatMap(group=>group.chapters);
const position=siblings.findIndex(entry=>entry.href===chapter.href);
const href=(entry:typeof chapter)=>`/read/${book}/${entry.href.split('/').pop()!.replace('chapter-','').replace('.html','')}/`;
const bookHref= `/read/${book}/`;
---
<BaseLayout title={`${chapter.title} · ${info.short}`}>
 <article class="book-article chapter-reading" data-book={book} data-reading-start={start}>
  <p class="book-source-line"><a href={bookHref}>{info.titleZh}</a></p>
  <div class="book-body" set:html={content} />
  <nav class="book-page-nav" aria-label="相邻章节">
   {siblings[position-1]&&<a href={href(siblings[position-1])}>← {siblings[position-1].title.split(' · ')[0]}</a>}
   <a href={bookHref}>返回目录</a>
   {siblings[position+1]&&<a href={href(siblings[position+1])}>{siblings[position+1].title.split(' · ')[0]} →</a>}
  </nav>
 </article>
 <script is:inline src="/reference-copy.js" defer></script>
 <script is:inline>
  // Citation fragments take precedence over the default position of a merged page.
  const start=document.querySelector('[data-reading-start]')?.getAttribute('data-reading-start');
  if(start&&!location.hash){const target=document.getElementById(start);if(target)requestAnimationFrame(()=>target.scrollIntoView());}
 </script>
</BaseLayout>
<style>
 :global(.chapter-reading[data-book="phb"] .table-note-heading){font-size:.95em;margin:1em 0 .35em;color:var(--muted)}
 :global(.chapter-reading[data-book="phb"] .heading-anchor){display:block;scroll-margin-top:1em}
</style>
