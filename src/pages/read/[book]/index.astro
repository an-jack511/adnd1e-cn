---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {reading} from '../../../utils/book-reading';
import BookReadingToc from '../../../components/BookReadingToc.astro';
import directory from '../../../data/public/book-directory.json';
export function getStaticPaths(){return Object.keys(reading).map(book=>({params:{book},props:{book}}));}
const {book}=Astro.props;
const info=directory.find(entry=>entry.id===book)!;
const groups=reading[book as keyof typeof reading];
---
<BaseLayout title={info.titleZh}>
 <article class="book-directory"><h1>{info.titleZh}<small lang="en">{info.title}</small></h1>
 {groups.map(group=><section class="book-toc-group">{group.title!=='章节'&&<h2>{group.title}</h2>}<BookReadingToc book={book} chapters={group.chapters}/></section>)}
 </article>
</BaseLayout>
