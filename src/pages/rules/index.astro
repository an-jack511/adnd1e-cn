---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { rules } from '../../data/public/rules';
import Bookshelf from '../../components/Bookshelf.astro';
import { libraryBooks, libraryCategories } from '../../data/bookshelf';
const groups = [{ key: 'combat', label: '战斗规则' }, { key: 'adventure', label: '冒险规则' }, { key: 'rules', label: '其他规则' }];
---
<BaseLayout title="规则库">
  <header class="shelf-page-heading"><h1>规则库</h1><p>按来源书阅读，或使用下方的规则索引快速查询。</p><nav class="shelf-page-links" aria-label="规则库导航"><a href="/books/">规则书库</a><a href="/manuals/">自编手册与法术书 →</a><a href="#rule-index">规则快捷索引 ↓</a></nav></header>
  <Bookshelf books={libraryBooks} categories={libraryCategories} label="规则库" />
  <section id="rule-index"><h2>规则快捷索引</h2><p><a href="/play/">按游戏情形查规则</a> · <a href="/play/combat/">战斗整页</a> · <a href="/play/travel/">旅行与探索</a> · <a href="/play/magic/">施法与魔法</a></p>{groups.map(group => <section><h3>{group.label}</h3><div class="link-index">{rules.filter(rule => rule.category === group.key && !rule.title.includes('预留')).map(rule => <a href={`/${rule.category === 'combat' ? 'combat' : rule.category === 'adventure' ? 'adventure' : 'rules'}/${rule.id}`}>{rule.title}</a>)}</div></section>)}</section>
</BaseLayout>
