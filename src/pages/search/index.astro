---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="全站搜索"><h1>全站搜索</h1><p class="lede">检索中文名、英文名、说明、标签、来源与别名。</p><form id="search-form" class="search-form"><label class="screen-only" for="query">搜索</label><input id="query" name="q" type="search" placeholder="例如：火球、Owlbear、PHB、战斗……" /><button type="submit">搜索</button></form><p id="search-status" class="results-count"></p><p id="search-related" class="small"></p><ol id="search-results" class="search-results"></ol>
  <script>
    const form = document.querySelector('#search-form'); const query = document.querySelector('#query'); const status = document.querySelector('#search-status'); const results = document.querySelector('#search-results'); const related = document.querySelector('#search-related');
    const params = new URLSearchParams(window.location.search); query.value = params.get('q') ?? '';
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    const score = (entry, term) => { const title = `${entry.nameZh} ${entry.nameEn}`.toLowerCase(); const exact = [entry.nameZh, entry.nameEn].some((value) => value?.toLowerCase() === term); return (exact ? 100 : title.includes(term) ? 45 : 0) + (entry.type === '游戏中' ? 24 : entry.type === '规则' ? 12 : entry.type === '规则书' ? -20 : 8); };
    const search = async () => { const term = query.value.trim().toLowerCase(); if (!term) { status.textContent = '请输入关键词。'; results.innerHTML = ''; related.textContent = ''; return; } const response = await fetch('/search-index.json'); const index = await response.json(); const found = index.filter((entry) => `${entry.nameZh} ${entry.nameEn} ${entry.description} ${entry.tags.join(' ')} ${entry.source.join(' ')} ${entry.aliases.join(' ')} ${entry.searchText ?? ''}`.toLowerCase().includes(term)).sort((a, b) => score(b, term) - score(a, term)); status.textContent = `找到 ${found.length} 条结果${found.length > 100 ? '（显示前 100 条）' : ''}`; related.innerHTML = found[0]?.type === '法术' ? '相关：<a href="/play/magic/">施法与魔法</a> · <a href="/play/combat/#spell-combat">战斗施法</a>' : ''; results.innerHTML = found.slice(0, 100).map((entry) => `<li><a href="${escapeHtml(entry.href)}">${escapeHtml(entry.nameZh)}${entry.nameEn ? ` / ${escapeHtml(entry.nameEn)}` : ''}</a><span class="result-meta">${escapeHtml(entry.type)} · ${escapeHtml(entry.source.join('、') || '来源待补')}</span><span class="small">${escapeHtml(entry.description.slice(0, 170))}${entry.description.length > 170 ? '…' : ''}</span></li>`).join(''); };
    form.addEventListener('submit', (event) => { event.preventDefault(); const url = new URL(window.location); url.searchParams.set('q', query.value); window.history.replaceState({}, '', url); search(); }); search();
  </script>
</BaseLayout>
