---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="全站搜索"><h1>全站搜索</h1><p class="lede">检索中文名、英文名、说明、标签、来源与别名。</p><form id="search-form" class="search-form"><label class="screen-only" for="query">搜索</label><input id="query" name="q" type="search" placeholder="例如：火球、Owlbear、PHB、战斗……" /><label>类型 <select id="search-type" name="type"><option value="">全部</option><option value="spell">法术</option><option value="monster">怪物</option><option value="item">装备</option><option value="class">职业</option><option value="race">种族</option><option value="rule">规则与教程</option><option value="book">规则书原文</option></select></label><button type="submit">搜索</button></form><p id="search-status" class="results-count"></p><p id="search-related" class="small"></p><ol id="search-results" class="search-results"></ol>
  <script>
    const form = document.querySelector('#search-form'); const query = document.querySelector('#query'); const type = document.querySelector('#search-type'); const status = document.querySelector('#search-status'); const results = document.querySelector('#search-results'); const related = document.querySelector('#search-related');
    const params = new URLSearchParams(window.location.search); query.value = params.get('q') ?? ''; type.value = params.get('type') ?? '';
    const typeMap = { spell: ['法术'], monster: ['怪物'], item: ['装备'], class: ['职业'], race: ['种族'], rule: ['规则', '游戏中'], book: ['规则书'] };
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    const score = (entry, term) => { const title = `${entry.nameZh} ${entry.nameEn}`.toLowerCase(); const exact = [entry.nameZh, entry.nameEn].some((value) => value?.toLowerCase() === term); return (exact ? 100 : title.includes(term) ? 45 : 0) + (entry.type === '游戏中' ? 24 : entry.type === '规则' ? 12 : entry.type === '规则书' ? -20 : 8); };
    const search = async () => { const term = query.value.trim().toLowerCase(); if (!term) { status.textContent = '请输入关键词。'; results.innerHTML = ''; related.textContent = ''; return; } status.textContent = '正在加载检索资料……'; try { const response = await fetch('/search-index.json'); if (!response.ok) throw new Error('index'); const index = await response.json(); const allowedTypes = typeMap[type.value]; const found = index.filter((entry) => (!allowedTypes || allowedTypes.includes(entry.type)) && `${entry.nameZh} ${entry.nameEn} ${entry.description} ${entry.tags.join(' ')} ${entry.source.join(' ')} ${entry.aliases.join(' ')} ${entry.searchText ?? ''}`.toLowerCase().includes(term)).sort((a, b) => score(b, term) - score(a, term)); status.textContent = `找到 ${found.length} 条结果${found.length > 100 ? '（显示前 100 条）' : ''}`; related.innerHTML = found[0]?.type === '法术' ? '相关：<a href="/play/magic/">施法与魔法</a> · <a href="/play/combat/#spell-combat">战斗施法</a>' : ''; results.innerHTML = found.slice(0, 100).map((entry) => `<li><a href="${escapeHtml(entry.href)}">${escapeHtml(entry.nameZh)}${entry.nameEn ? ` / ${escapeHtml(entry.nameEn)}` : ''}</a><span class="result-meta">${escapeHtml(entry.type)} · ${escapeHtml(entry.source.join('、') || '来源待补')}</span><span class="small">${escapeHtml(entry.description.slice(0, 170))}${entry.description.length > 170 ? '…' : ''}</span></li>`).join(''); } catch { status.textContent = '检索资料加载失败，请刷新后重试。'; results.innerHTML = ''; } };
    form.addEventListener('submit', (event) => { event.preventDefault(); const url = new URL(window.location); query.value ? url.searchParams.set('q', query.value) : url.searchParams.delete('q'); type.value ? url.searchParams.set('type', type.value) : url.searchParams.delete('type'); window.history.replaceState({}, '', url); search(); }); search();
  </script>
</BaseLayout>
