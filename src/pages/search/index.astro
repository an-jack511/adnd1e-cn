---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="全站搜索"><h1>全站搜索</h1><p class="lede">静态生成的 search-index.json，覆盖中文名、英文名、说明、标签、来源与别名字段。</p><form id="search-form" class="search-form"><label class="screen-only" for="query">搜索</label><input id="query" name="q" type="search" placeholder="例如：火球、Owlbear、PHB、战斗……" /><button type="submit">搜索</button></form><p id="search-status" class="results-count"></p><ol id="search-results" class="search-results"></ol>
  <script>
    const form = document.querySelector('#search-form'); const query = document.querySelector('#query'); const status = document.querySelector('#search-status'); const results = document.querySelector('#search-results');
    const params = new URLSearchParams(window.location.search); query.value = params.get('q') ?? '';
    const search = async () => { const term = query.value.trim().toLowerCase(); if (!term) { status.textContent = '请输入关键词。'; results.innerHTML = ''; return; } const response = await fetch('/search-index.json'); const index = await response.json(); const found = index.filter((entry) => `${entry.nameZh} ${entry.nameEn} ${entry.description} ${entry.tags.join(' ')} ${entry.source.join(' ')} ${entry.aliases.join(' ')}`.toLowerCase().includes(term)); status.textContent = `找到 ${found.length} 条结果`; results.innerHTML = found.map((entry) => `<li><span class="result-type">${entry.type}</span><a href="${entry.href}">${entry.nameZh}</a> <span class="muted">${entry.nameEn}</span><br /><span class="small">${entry.description}</span></li>`).join(''); };
    form.addEventListener('submit', (event) => { event.preventDefault(); const url = new URL(window.location); url.searchParams.set('q', query.value); window.history.replaceState({}, '', url); search(); }); search();
  </script>
</BaseLayout>
