---
import LibraryRules from '../../components/LibraryRules.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import PublishedLinks from '../../components/PublishedLinks.astro';
import { spells } from '../../data/public/spells';
import { bilingualSpellSchool } from '../../utils/spell-schools';
import dragonVersions from '../../data/public/dragon-spell-versions.json';
import {spellRuleHeader} from '../../utils/spell-layout';
export function getStaticPaths() { return [...spells.map((spell) => ({ params: { id: spell.id }, props: { spell, redirectTo: undefined } })), ...Object.entries(dragonVersions).map(([id,version])=>({params:{id},props:{spell:spells.find(spell=>spell.id===version.targetId)!,redirectTo:`/spells/${version.targetId}/`}}))]; }
const { spell, redirectTo } = Astro.props;
if(redirectTo)return Astro.redirect(redirectTo,301);
const magazine=spell.id.startsWith('dragon-');
---
<BaseLayout title={`${spell.nameZh} ${spell.nameEn}`} description={`${spell.nameZh}（${spell.nameEn}）AD&D 1E 法术条目。`}>
  <article class="library-entry">
    <header class="entry-header"><h1>{spell.nameZh}</h1><div class="english">{spell.nameEn} · {spell.classes.join(' / ')}</div></header>
    {magazine ? <div class="spell-rule-header" set:html={spellRuleHeader(spell)} /> : <div class="entry-meta">
      <div><dt>环级</dt><dd>{spell.level}</dd></div><div><dt>学派</dt><dd>{bilingualSpellSchool(spell.school)}</dd></div><div><dt>成分</dt><dd>{spell.components.join(' / ')}</dd></div><div><dt>施法时间</dt><dd>{spell.castingTime}</dd></div>
      <div><dt>距离</dt><dd>{spell.range}</dd></div><div><dt>持续时间</dt><dd>{spell.duration}</dd></div><div><dt>范围</dt><dd>{spell.areaOfEffect}</dd></div><div><dt>豁免</dt><dd>{spell.savingThrow}</dd></div>
    </div>}
    {!magazine && spell.reversible && <p class="notice"><strong>可逆法术：</strong>请同时查阅正向与逆向效果。</p>}
    {spell.details?.length ? <LibraryRules prefix={spell.id} details={spell.details} /> : <p>{spell.description}</p>}
    {!magazine && spell.materialComponent && <p><strong>材料成分：</strong>{spell.materialComponent}</p>}
    <p>{spell.tags.map((tag) => <span class="tag">{tag}</span>)}</p>
    {!spell.details?.length && <PublishedLinks kind="spell" id={spell.id} classes={spell.classes} />}
    <SourceList sources={spell.source} details={spell.details} />
    <p><a href="/spells">← 返回法术表</a></p>
  </article>
</BaseLayout>
