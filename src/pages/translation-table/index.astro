---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="中英术语对照表" description="AD&D 第一版中文规则索引的中英术语与专名对照表。">
  <h1>中英术语对照表</h1>
  <p>中文正文以中文译名为主；英文列用于查找原名、核对术语和处理必要的中英对照。规则缩写、骰式、来源代码等格式性英文不在此强行改写。</p>
  <form id="terms-form" class="lookup">
    <label>查找术语<input id="terms-query" type="search" placeholder="中文或 English" /></label>
    <label>类别<select id="terms-category"><option value="">全部</option></select></label>
    <button>查找</button>
  </form>
  <p id="terms-count" role="status">正在载入术语表…</p>
  <div class="table-wrap" tabindex="0" role="region" aria-label="中英术语对照表">
    <table>
      <thead><tr><th>中文译名</th><th>English</th><th>类别</th><th>核对状态</th></tr></thead>
      <tbody id="terms-body"></tbody>
    </table>
  </div>
  <nav class="pagination" aria-label="术语表分页">
    <button id="terms-prev" type="button">上一页</button>
    <span id="terms-page" aria-live="polite">第 1 页</span>
    <button id="terms-next" type="button">下一页</button>
  </nav>
  <script>
    type Entry = { en:string; zh:string; category:string; status:string };
    const labels:Record<string,string> = { class:'职业', item:'物品', monster:'怪物', proper:'专名', race:'种族', rule:'规则', spell:'法术' };
    const pageSize = 100;
    const form = document.querySelector<HTMLFormElement>('#terms-form')!;
    const query = document.querySelector<HTMLInputElement>('#terms-query')!;
    const category = document.querySelector<HTMLSelectElement>('#terms-category')!;
    const count = document.querySelector('#terms-count')!;
    const body = document.querySelector('#terms-body')!;
    const previous = document.querySelector<HTMLButtonElement>('#terms-prev')!;
    const next = document.querySelector<HTMLButtonElement>('#terms-next')!;
    const pageLabel = document.querySelector('#terms-page')!;
    let entries:Entry[] = [];
    let page = 1;
    function render() {
      const q = query.value.trim().toLowerCase();
      const hits = entries.filter(e => (!category.value || e.category === category.value) && (!q || `${e.zh} ${e.en}`.toLowerCase().includes(q)));
      const pageCount = Math.max(1, Math.ceil(hits.length / pageSize));
      page = Math.min(page, pageCount);
      const start = (page - 1) * pageSize;
      body.replaceChildren(...hits.slice(start, start + pageSize).map(e => {
        const row = document.createElement('tr');
        for (const value of [e.zh, e.en, labels[e.category] || e.category, e.status]) {
          const cell = document.createElement('td'); cell.textContent = value; row.append(cell);
        }
        return row;
      }));
      count.textContent = `共 ${hits.length} 项。`;
      pageLabel.textContent = `第 ${page} / ${pageCount} 页`;
      previous.disabled = page <= 1;
      next.disabled = page >= pageCount;
    }
    async function init() {
      const response = await fetch('/translation-table.json');
      if (!response.ok) throw new Error('translation table');
      const data = await response.json() as { entries:Entry[] };
      entries = data.entries;
      [...new Set(entries.map(e => e.category))].sort().forEach(value => category.add(new Option(labels[value] || value, value)));
      render();
    }
    form.onsubmit = event => { event.preventDefault(); page = 1; render(); };
    query.oninput = () => { page = 1; render(); };
    category.onchange = () => { page = 1; render(); };
    previous.onclick = () => { page -= 1; render(); };
    next.onclick = () => { page += 1; render(); };
    init().catch(() => { count.textContent = '术语表载入失败，请刷新页面重试。'; });
  </script>
</BaseLayout>
