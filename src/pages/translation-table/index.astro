---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="中英术语对照表" description="AD&D 第一版中文规则索引的中英术语与专名对照表。">
  <h1>中英术语对照表</h1>
  <p>本表收录 AD&amp;D 1E 资料中的术语与跨版本名称参考。标为“版本参考”的译名只适用于对应版本，不直接作为 1E 定译；规则缩写、骰式和来源代码保留原格式。AI 与其他程序可通过 <a href="/api/terminology/v1.json">开放 JSON 接口</a>读取全表，接口说明见 <a href="/api/terminology/openapi-v1.json">OpenAPI 文档</a>。</p>
  <form id="terms-form" class="lookup">
    <label>查找术语<input id="terms-query" type="search" placeholder="中文、English 或旧译" /></label>
    <label>类别<select id="terms-category"><option value="">全部</option></select></label>
    <button>查找</button>
  </form>
  <p id="terms-count" role="status">正在载入术语表…</p>
  <div id="terms-grid" class="terms-grid" role="list" aria-label="中英术语对照表"></div>
  <nav class="pagination" aria-label="术语表分页">
    <button id="terms-prev" type="button">上一页</button>
    <span id="terms-page" aria-live="polite">第 1 页</span>
    <button id="terms-next" type="button">下一页</button>
  </nav>
  <script>
    type Entry = { en:string; zh:string; category:string; status:string; references:string[]; aliases:string[]; englishVariants:string[] };
    const labels:Record<string,string> = {
      action:'行动', background:'背景', boon:'恩赐', book:'书目', candidate:'名称候选', charoption:'角色选项', class:'职业',
      classFeature:'职业特性', condition:'状态', cult:'教团', disease:'疾病', feat:'专长', hazard:'危害', heading:'资料标题候选',
      item:'物品', language:'语言', languageScript:'文字系统', magicvariant:'魔法物品变体', monster:'怪物',
      object:'物件', optionalfeature:'可选特性', psionic:'灵能', proper:'专名', race:'种族', recipe:'配方',
      'glossary-context':'原书术语表（语境待分）', 'glossary-term':'原书术语表', 'legacy-term':'历史译名索引', reward:'奖励', rule:'规则', 'setting-reference':'设定名称索引（含标题候选）', skill:'技能',
      spell:'法术', status:'状态', subclass:'子职', subclassFeature:'子职特性', table:'表格名称',
      trap:'陷阱', variantrule:'变体规则', vehicle:'载具', vehicleUpgrade:'载具改装',
    };
    const statuses:Record<string,string> = {
      'verified-exact':'名称已核对', pending:'待核对', 'adapted-element':'部分语素已核',
      'adapted-variant':'译名已注明调整', 'reference-conflict':'来源译名有分歧',
      'reference-only':'版本参考（仅名称）',
    };
    const pageSize = 600;
    const form = document.querySelector<HTMLFormElement>('#terms-form')!;
    const query = document.querySelector<HTMLInputElement>('#terms-query')!;
    const category = document.querySelector<HTMLSelectElement>('#terms-category')!;
    const count = document.querySelector('#terms-count')!;
    const grid = document.querySelector<HTMLDivElement>('#terms-grid')!;
    const previous = document.querySelector<HTMLButtonElement>('#terms-prev')!;
    const next = document.querySelector<HTMLButtonElement>('#terms-next')!;
    const pageLabel = document.querySelector('#terms-page')!;
    let entries:Entry[] = [];
    let page = 1;
    function render() {
      const q = query.value.trim().toLowerCase();
      const hits = entries.filter(e => (!category.value || e.category === category.value) && (!q || `${e.zh} ${e.en} ${e.aliases.join(' ')} ${e.englishVariants.join(' ')}`.toLowerCase().includes(q)));
      const pageCount = Math.max(1, Math.ceil(hits.length / pageSize));
      page = Math.min(page, pageCount);
      const start = (page - 1) * pageSize;
      grid.replaceChildren(...hits.slice(start, start + pageSize).map(e => {
        const card = document.createElement('article');
        card.className = 'term-card';
        card.setAttribute('role', 'listitem');
        card.title = e.references.join('；');
        const zh = document.createElement('strong');
        zh.className = 'term-zh';
        zh.textContent = e.zh;
        const en = document.createElement('span');
        en.className = 'term-en';
        en.textContent = e.en;
        const meta = document.createElement('span');
        meta.className = 'term-meta';
        meta.textContent = `${labels[e.category] || e.category} · ${statuses[e.status] || e.status}`;
        card.append(zh, en, meta);
        return card;
      }));
      count.textContent = `共 ${hits.length} 项。将鼠标悬停在词条上可查看出处。`;
      pageLabel.textContent = `第 ${page} / ${pageCount} 页`;
      previous.disabled = page <= 1;
      next.disabled = page >= pageCount;
    }
    async function init() {
      const response = await fetch('/translation-table.json');
      if (!response.ok) throw new Error('translation table');
      const data = await response.json() as { entries:Entry[] };
      entries = data.entries;
      [...new Set(entries.map(e => e.category))].sort().forEach(value => category.add(new Option(labels[value] || value, value)));
      render();
    }
    form.onsubmit = event => { event.preventDefault(); page = 1; render(); };
    query.oninput = () => { page = 1; render(); };
    category.onchange = () => { page = 1; render(); };
    previous.onclick = () => { page -= 1; render(); };
    next.onclick = () => { page += 1; render(); };
    init().catch(() => { count.textContent = '术语表载入失败，请刷新页面重试。'; });
  </script>
  <style>
    .terms-grid { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:5px; }
    .term-card { min-width:0; padding:5px 6px; border:1px solid var(--line); background:var(--surface); color:var(--ink); font-size:11px; line-height:1.35; }
    .term-zh,.term-en,.term-meta { display:block; min-width:0; overflow-wrap:anywhere; }
    .term-zh { font-size:12px; line-height:1.4; }
    .term-en { margin-top:2px; color:var(--muted); font-size:10px; }
    .term-meta { margin-top:3px; color:var(--muted); font-size:9px; }
    @media(max-width:760px) { .terms-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } }
    @media(max-width:560px) { .terms-grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:4px; } .term-card { padding:5px; } }
    @media(max-width:420px) { .terms-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:320px) { .terms-grid { grid-template-columns:1fr; } }
  </style>
</BaseLayout>
